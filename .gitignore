# Build artifacts (regenerated by cc / objasm / cmhg / amu)
Source/**/o/
Source/**/rm/
Source/**/h/*Hdr

# Built binaries produced in the Source tree by a build. The live copies that
# the running BBS actually loads are committed under !Converse/Resources/ and
# BlockDrivers/; the Source-tree outputs are just intermediates.
Source/FTN/FTN,ff8
Source/LineTask/Line,ff8
Source/Serial/Serial,ff8
Source/Server/Server,ff8
Source/UserEd/UserEd,ff8
Source/Web/Web,ff8
Source/Pipes/blockdrivers/PipeClient,ffd
Source/Pipes/blockdrivers/PipeHost,ffd

# Runtime logs and transient upload staging (leading ! escaped for gitignore)
\!Converse/Logs/
\!Converse/Temp/Upload_*
\!Converse/Temp/received,ffd

# Python caches and telnet-test download outputs
__pycache__/
*.pyc
tools/telnet-test/incoming/
