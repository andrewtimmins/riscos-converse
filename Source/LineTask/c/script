    }

    if (script_stringcasecmp(token, "sendnetmail") == 0)
    {
        /* SENDNETMAIL <address> <name> <subject> <body> (name/subject/body
           backtick-quoted). Parsed backtick-aware; macro-expanded at execute. */
        char *rest = strtok(NULL, "");
        char *a1 = NULL, *a2 = NULL, *a3 = NULL, *a4 = NULL;
        char *p = rest;

        script_arg_next(&p, &a1);
        script_arg_next(&p, &a2);
        script_arg_next(&p, &a3);
        script_arg_next(&p, &a4);

        instruction->type = SCRIPT_CMD_SENDNETMAIL;
        instruction->arg1 = (a1 != NULL) ? a1 : script_duplicate_string("");
        instruction->arg2 = (a2 != NULL) ? a2 : script_duplicate_string("");
        instruction->arg3 = (a3 != NULL) ? a3 : script_duplicate_string("");
        instruction->arg4 = (a4 != NULL) ? a4 : script_duplicate_string("");
        return 1;
    }

    /* Math commands: add, sub, mul, div, mod
     * Syntax: add <result_var> <operand1> <operand2>
     */
    if (script_stringcasecmp(token, "add") == 0)
    {
        char *result = strtok(NULL, " \t");
        char *op1 = strtok(NULL, " \t");
        char *op2 = strtok(NULL, " \t");
        if (result == NULL || op1 == NULL || op2 == NULL)
        {
            script_set_error(state, "Malformed add on line %d (usage: add result op1 op2)", line_number);
            return 0;
        }
        instruction->type = SCRIPT_CMD_ADD;
        instruction->arg1 = script_duplicate_string(result);
        instruction->arg2 = script_duplicate_string(op1);
        instruction->arg3 = script_duplicate_string(op2);
        return 1;
    }

    if (script_stringcasecmp(token, "sub") == 0)
    {
        char *result = strtok(NULL, " \t");
        char *op1 = strtok(NULL, " \t");
        char *op2 = strtok(NULL, " \t");
        if (result == NULL || op1 == NULL || op2 == NULL)
