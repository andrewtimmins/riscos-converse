            {
                value_string = script_duplicate_string(arg_text);
            }
            instruction->arg2 = value_string;
        }
        return 1;
    }

    script_set_error(state, "Unknown command '%s' on line %d", token, line_number);
    return 0;
}

static char *script_duplicate_string(const char *source)
{
    char *copy;
    if (source == NULL)
    {
        return NULL;
    }
    copy = (char *)malloc(strlen(source) + 1);
    if (copy != NULL)
    {
        strcpy(copy, source);
    }
    return copy;
}

static int script_append_instruction(script_state *state, script_instruction *instr)
{
    if (state->instruction_count >= state->instruction_capacity)
    {
        size_t new_capacity = state->instruction_capacity + SCRIPT_DEFAULT_INSTRUCTION_CAPACITY;
        script_instruction *resized = (script_instruction *)realloc(state->instructions, new_capacity * sizeof(script_instruction));
        if (resized == NULL)
        {
            return 0;
        }
        state->instructions = resized;
        state->instruction_capacity = new_capacity;
    }

    state->instructions[state->instruction_count] = *instr;
    state->instruction_count++;
    return 1;
}

static int script_register_label(script_state *state, const char *name)
{
    if (name == NULL || *name == '\0')
    {
        return 0;
    }

    if (state->label_count >= state->label_capacity)
    {
        size_t new_capacity = state->label_capacity + SCRIPT_DEFAULT_LABEL_CAPACITY;
        script_label *resized = (script_label *)realloc(state->labels, new_capacity * sizeof(script_label));
        if (resized == NULL)
        {
            return 0;
        }
        state->labels = resized;
        state->label_capacity = new_capacity;
    }

    state->labels[state->label_count].name = script_duplicate_string(name);
    state->labels[state->label_count].instruction_index = state->instruction_count;
    state->label_count++;
    return 1;
}

static size_t script_find_label(const script_state *state, const char *name, int *found)
{
    if (found != NULL)
    {
        *found = 0;
    }

    size_t i;

    if (state == NULL || name == NULL)
    {
        return 0;
    }

    for (i = 0; i < state->label_count; ++i)
    {
        if (state->labels[i].name != NULL && script_stringcasecmp(state->labels[i].name, name) == 0)
        {
            if (found != NULL)
            {
                *found = 1;
            }
            return state->labels[i].instruction_index;
        }
    }

    return 0;
}

static script_variable *script_find_variable(script_state *state, const char *name, int create_if_missing)
{
    size_t i;

    if (state == NULL || name == NULL)
    {
        return NULL;
    }

    for (i = 0; i < state->variable_count; ++i)
    {
        if (script_stringcasecmp(state->variables[i].name, name) == 0)
        {
            return &state->variables[i];
        }
    }

    if (!create_if_missing)
    {
        return NULL;
    }

    if (state->variable_count >= state->variable_capacity)
    {
        size_t new_capacity = state->variable_capacity + SCRIPT_DEFAULT_VARIABLE_CAPACITY;
        script_variable *resized = (script_variable *)realloc(state->variables, new_capacity * sizeof(script_variable));
        if (resized == NULL)
        {
            return NULL;
        }
        state->variables = resized;
        state->variable_capacity = new_capacity;
    }

    memset(&state->variables[state->variable_count], 0, sizeof(script_variable));
    strncpy(state->variables[state->variable_count].name, name, sizeof(state->variables[state->variable_count].name) - 1);
    state->variables[state->variable_count].value = script_duplicate_string("");
    state->variable_count++;
    return &state->variables[state->variable_count - 1];
}

/* ===========================================================================
 * EXPRESSION EVALUATOR  (recursive descent, string values on the heap)
 *
 * Grammar (low -> high precedence):
 *   or   := and  ( ('||'|'or')  and  )*
 *   and  := not  ( ('&&'|'and') not  )*
 *   not  := ('!'|'not') not | cmp
 *   cmp  := add  ( ('=='|'!='|'<'|'>'|'<='|'>='|'contains') add )?
 *   add  := mul  ( ('+'|'-') mul )*        '+' concatenates if either side is non-numeric
 *   mul  := un   ( ('*'|'/'|'%') un )*
 *   un   := '-' un | primary
 *   primary := number | '"'string'"' | `string` | %{macro} | ident['('args')'] | '(' or ')'
 * Every level returns a malloc'd string; operators free their operands.
 * =========================================================================== */

typedef struct
{
    const char *p;
    script_state *state;
    int depth;
    int error;
} expr_ctx;

#define SCRIPT_EXPR_MAX_DEPTH 48
#define SCRIPT_EXPR_MAX_ARGS  16

static char *expr_strdup(const char *s)
{
    return script_duplicate_string(s ? s : "");
}

static char *expr_from_long(long v)
{
    char buf[32];
    snprintf(buf, sizeof(buf), "%ld", v);
    return expr_strdup(buf);
}

/* Is s a plain integer (optional sign + digits, surrounding whitespace ok)? */
static int expr_is_num(const char *s)
{
    int digits = 0;
    if (s == NULL) return 0;
    while (*s == ' ' || *s == '\t') s++;
    if (*s == '+' || *s == '-') s++;
    while (*s >= '0' && *s <= '9') { s++; digits++; }
    while (*s == ' ' || *s == '\t') s++;
    return (digits > 0 && *s == '\0');
}

static long expr_to_long(const char *s)
{
    return s ? atol(s) : 0;
}

/* Truthiness: non-empty, not "0", not "false"/"no" (case-insensitive). */
static int expr_truthy_str(const char *s)
{
    const char *t;
    if (s == NULL) return 0;
    t = s;
    while (*t == ' ' || *t == '\t') t++;
    if (*t == '\0') return 0;
    if (strcmp(t, "0") == 0) return 0;
    if (script_stringcasecmp(t, "false") == 0) return 0;
    if (script_stringcasecmp(t, "no") == 0) return 0;
    return 1;
}

static char *expr_bool(int v) { return expr_strdup(v ? "1" : "0"); }

static void expr_ws(expr_ctx *c) { while (*c->p == ' ' || *c->p == '\t') c->p++; }

static int expr_is_ident_char(char ch)
{
    return (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') ||
           (ch >= '0' && ch <= '9') || ch == '_';
}

/* Match a keyword operator (and/or/not/contains) as a whole word; advances on match. */
static int expr_match_word(expr_ctx *c, const char *word)
{
    size_t len = strlen(word);
    const char *save = c->p;
    expr_ws(c);
    if (script_strncasecmp(c->p, word, len) == 0 && !expr_is_ident_char(c->p[len]))
    {
        c->p += len;
        return 1;
    }
    c->p = save;
    return 0;
}

static char *expr_parse_or(expr_ctx *c);

/* primary */
static char *expr_parse_primary(expr_ctx *c)
{
    char *result;
    expr_ws(c);

    if (c->depth > SCRIPT_EXPR_MAX_DEPTH) { c->error = 1; return NULL; }

    /* parenthesised */
    if (*c->p == '(')
    {
        c->p++;
        c->depth++;
        result = expr_parse_or(c);
        c->depth--;
        if (result == NULL) return NULL;
        expr_ws(c);
        if (*c->p == ')') c->p++;
        else { c->error = 1; free(result); return NULL; }
        return result;
    }

    /* number */
    if ((*c->p >= '0' && *c->p <= '9'))
    {
        const char *start = c->p;
        while (*c->p >= '0' && *c->p <= '9') c->p++;
        {
            size_t n = (size_t)(c->p - start);
            char *v = (char *)malloc(n + 1);
            if (v == NULL) { c->error = 1; return NULL; }
            memcpy(v, start, n); v[n] = '\0';
            return v;
        }
    }

    /* string literal "..." with basic escapes */
    if (*c->p == '"')
    {
        script_buffer sb;
        script_buffer_init(&sb);
        c->p++;
        while (*c->p != '\0' && *c->p != '"')
        {
            char ch = *c->p++;
            if (ch == '\\' && *c->p != '\0')
            {
                char e = *c->p++;
                if (e == 'n') ch = '\n';
                else if (e == 'r') ch = '\r';
                else if (e == 't') ch = '\t';
                else ch = e;
            }
            script_buffer_append_char(&sb, ch);
        }
        if (*c->p == '"') c->p++;
        result = expr_strdup(sb.data ? sb.data : "");
        script_buffer_free(&sb);
        return result;
    }

    /* backtick raw string */
    if (*c->p == '`')
    {
        const char *start = ++c->p;
        while (*c->p != '\0' && *c->p != '`') c->p++;
        {
            size_t n = (size_t)(c->p - start);
            char *v = (char *)malloc(n + 1);
            if (v == NULL) { c->error = 1; return NULL; }
            memcpy(v, start, n); v[n] = '\0';
            if (*c->p == '`') c->p++;
            return v;
        }
    }

    /* %{macro} */
    if (c->p[0] == '%' && c->p[1] == '{')
    {
        const char *start = c->p;
        char macrobuf[256];
        char expanded[SCRIPT_EXPAND_BUFFER_SIZE];
        size_t n;
        c->p += 2;
        while (*c->p != '\0' && *c->p != '}') c->p++;
        if (*c->p == '}') c->p++;
        n = (size_t)(c->p - start);
        if (n >= sizeof(macrobuf)) n = sizeof(macrobuf) - 1;
        memcpy(macrobuf, start, n); macrobuf[n] = '\0';
        script_expand_macros(c->state, macrobuf, expanded, sizeof(expanded));
        return expr_strdup(expanded);
    }

    /* identifier: variable or function call */
    if ((*c->p >= 'A' && *c->p <= 'Z') || (*c->p >= 'a' && *c->p <= 'z') || *c->p == '_')
    {
        char name[64];
        size_t n = 0;
        while (expr_is_ident_char(*c->p) && n < sizeof(name) - 1) name[n++] = *c->p++;
        name[n] = '\0';
        expr_ws(c);
        if (*c->p == '(')
        {
            /* function call */
            char *args[SCRIPT_EXPR_MAX_ARGS];
            int nargs = 0, i, handled = 0;
            char *fnres;
            c->p++;
            expr_ws(c);
            if (*c->p != ')')
            {
                for (;;)
                {
                    char *a;
                    if (nargs >= SCRIPT_EXPR_MAX_ARGS) { c->error = 1; break; }
                    c->depth++;
                    a = expr_parse_or(c);
                    c->depth--;
                    if (a == NULL) { c->error = 1; break; }
                    args[nargs++] = a;
                    expr_ws(c);
                    if (*c->p == ',') { c->p++; continue; }
                    break;
                }
            }
            expr_ws(c);
            if (*c->p == ')') c->p++; else c->error = 1;
            if (c->error) { for (i = 0; i < nargs; i++) free(args[i]); return NULL; }

            fnres = script_expr_call_function(c->state, name, args, nargs, &handled);
            if (!handled)
                fnres = script_run_user_function(c->state, name, args, nargs, &handled);
            for (i = 0; i < nargs; i++) free(args[i]);
            if (!handled)
            {
                /* unknown function -> empty (don't hard-error; keeps scripts forgiving) */
                return expr_strdup("");
            }
            return fnres ? fnres : expr_strdup("");
        }
        /* plain variable; an UNSET bare word falls back to its own text as a
         * string literal, so legacy conditions like `if choice == y` still work
         * (barewords are literals unless they name a defined variable). */
        {
            const char *val = script_get_variable_value(c->state, name);
            return expr_strdup(val ? val : name);
        }
    }

    /* nothing recognised -> empty */
    return expr_strdup("");
}

static char *expr_parse_unary(expr_ctx *c)
{
    expr_ws(c);
    if (*c->p == '-')
    {
        char *v;
        c->p++;
        v = expr_parse_unary(c);
        if (v == NULL) return NULL;
        { char *r = expr_from_long(-expr_to_long(v)); free(v); return r; }
    }
    return expr_parse_primary(c);
}

static char *expr_parse_mul(expr_ctx *c)
{
    char *left = expr_parse_unary(c);
    if (left == NULL) return NULL;
    for (;;)
    {
        char op; char *right; long a, b, r;
        expr_ws(c);
        op = *c->p;
        if (op != '*' && op != '/' && op != '%') break;
        c->p++;
        right = expr_parse_unary(c);
        if (right == NULL) { free(left); return NULL; }
        a = expr_to_long(left); b = expr_to_long(right);
        if (op == '*') r = a * b;
        else if (op == '/') r = (b != 0) ? a / b : 0;
        else r = (b != 0) ? a % b : 0;
        free(left); free(right);
        left = expr_from_long(r);
        if (left == NULL) return NULL;
    }
    return left;
}

static char *expr_parse_add(expr_ctx *c)
{
    char *left = expr_parse_mul(c);
    if (left == NULL) return NULL;
    for (;;)
    {
        char op; char *right;
        expr_ws(c);
        op = *c->p;
        if (op != '+' && op != '-') break;
        c->p++;
        right = expr_parse_mul(c);
        if (right == NULL) { free(left); return NULL; }
        if (op == '-')
        {
            char *r = expr_from_long(expr_to_long(left) - expr_to_long(right));
            free(left); free(right); left = r;
        }
        else /* '+' : numeric add if both numeric, else concatenate */
        {
            if (expr_is_num(left) && expr_is_num(right))
            {
                char *r = expr_from_long(expr_to_long(left) + expr_to_long(right));
                free(left); free(right); left = r;
            }
            else
            {
                size_t la = strlen(left), lb = strlen(right);
                char *r = (char *)malloc(la + lb + 1);
                if (r == NULL) { free(left); free(right); c->error = 1; return NULL; }
                memcpy(r, left, la); memcpy(r + la, right, lb); r[la + lb] = '\0';
                free(left); free(right); left = r;
            }
        }
        if (left == NULL) return NULL;
    }
    return left;
}

static char *expr_parse_cmp(expr_ctx *c)
{
    char *left = expr_parse_add(c);
    char op[3]; char *right; int res;
    if (left == NULL) return NULL;
    expr_ws(c);

    op[0] = op[1] = op[2] = '\0';
    if (expr_match_word(c, "contains"))
    {
        right = expr_parse_add(c);
        if (right == NULL) { free(left); return NULL; }
        res = (strstr(left, right) != NULL);
        free(left); free(right);
        return expr_bool(res);
    }
    if ((c->p[0] == '=' && c->p[1] == '=') || (c->p[0] == '!' && c->p[1] == '=') ||
        (c->p[0] == '<' && c->p[1] == '=') || (c->p[0] == '>' && c->p[1] == '='))
    { op[0] = c->p[0]; op[1] = c->p[1]; c->p += 2; }
    else if (c->p[0] == '<' || c->p[0] == '>')
    { op[0] = c->p[0]; c->p += 1; }
    else
        return left; /* no comparison */

    right = expr_parse_add(c);
    if (right == NULL) { free(left); return NULL; }

    if (op[0] == '=' && op[1] == '=')
        res = (script_stringcasecmp(left, right) == 0);
    else if (op[0] == '!' && op[1] == '=')
        res = (script_stringcasecmp(left, right) != 0);
    else
    {
        /* ordering: numeric if both numeric, else lexical */
        if (expr_is_num(left) && expr_is_num(right))
        {
            long a = expr_to_long(left), b = expr_to_long(right);
            if (op[0] == '<') res = op[1] == '=' ? (a <= b) : (a < b);
            else               res = op[1] == '=' ? (a >= b) : (a > b);
        }
        else
        {
            int cmp = script_stringcasecmp(left, right);
            if (op[0] == '<') res = op[1] == '=' ? (cmp <= 0) : (cmp < 0);
            else               res = op[1] == '=' ? (cmp >= 0) : (cmp > 0);
        }
    }
    free(left); free(right);
    return expr_bool(res);
}

static char *expr_parse_not(expr_ctx *c)
{
    expr_ws(c);
    if (*c->p == '!' || expr_match_word(c, "not"))
    {
        char *v;
        if (*c->p == '!') c->p++;
        v = expr_parse_not(c);
        if (v == NULL) return NULL;
        { int t = expr_truthy_str(v); free(v); return expr_bool(!t); }
    }
    return expr_parse_cmp(c);
}

static char *expr_parse_and(expr_ctx *c)
{
    char *left = expr_parse_not(c);
    if (left == NULL) return NULL;
    for (;;)
    {
        char *right; int l, r;
        expr_ws(c);
        if (!((c->p[0] == '&' && c->p[1] == '&') || expr_match_word(c, "and"))) break;
        if (c->p[0] == '&') c->p += 2;
        right = expr_parse_not(c);
        if (right == NULL) { free(left); return NULL; }
        l = expr_truthy_str(left); r = expr_truthy_str(right);
        free(left); free(right);
        left = expr_bool(l && r);
    }
    return left;
}

static char *expr_parse_or(expr_ctx *c)
{
    char *left = expr_parse_and(c);
    if (left == NULL) return NULL;
    for (;;)
    {
        char *right; int l, r;
        expr_ws(c);
        if (!((c->p[0] == '|' && c->p[1] == '|') || expr_match_word(c, "or"))) break;
        if (c->p[0] == '|') c->p += 2;
        right = expr_parse_and(c);
        if (right == NULL) { free(left); return NULL; }
        l = expr_truthy_str(left); r = expr_truthy_str(right);
        free(left); free(right);
        left = expr_bool(l || r);
    }
    return left;
}

static char *script_expr_eval(script_state *state, const char *expr, int *ok)
{
    expr_ctx c;
    char *result;
    if (ok) *ok = 0;
    if (state == NULL || expr == NULL) return NULL;
    c.p = expr; c.state = state; c.depth = 0; c.error = 0;
    result = expr_parse_or(&c);
    if (result == NULL || c.error)
    {
        if (result) free(result);
        return NULL;
    }
    if (ok) *ok = 1;
    return result;
}

static int script_expr_truthy(script_state *state, const char *expr)
{
    int ok = 0, t;
    char *v = script_expr_eval(state, expr, &ok);
    if (!ok || v == NULL) { if (v) free(v); return 0; }
    t = expr_truthy_str(v);
    free(v);
    return t;
}

/* Built-in expression functions. Sets *handled=1 if the name is a builtin.
 * Returns a malloc'd result string (or NULL). Data-API / file / KV builtins
 * are appended in script_expr_call_function_ext (phase 2). */
#define EXPR_ARG(i)  ((i) < nargs && args[i] ? args[i] : "")
static char *script_expr_call_function_ext(script_state *state, const char *name,
                                           char **args, int nargs, int *handled);

static char *script_expr_call_function(script_state *state, const char *name,
                                       char **args, int nargs, int *handled)
{
    *handled = 1;

    if (script_stringcasecmp(name, "len") == 0 || script_stringcasecmp(name, "length") == 0)
        return expr_from_long((long)strlen(EXPR_ARG(0)));

    if (script_stringcasecmp(name, "upper") == 0)
    {
        char *r = expr_strdup(EXPR_ARG(0)); char *p = r;
        if (r) for (; *p; p++) *p = (char)toupper((unsigned char)*p);
        return r;
    }
    if (script_stringcasecmp(name, "lower") == 0)
    {
        char *r = expr_strdup(EXPR_ARG(0)); char *p = r;
        if (r) for (; *p; p++) *p = (char)tolower((unsigned char)*p);
        return r;
    }
    if (script_stringcasecmp(name, "trim") == 0 || script_stringcasecmp(name, "ltrim") == 0 ||
        script_stringcasecmp(name, "rtrim") == 0)
    {
        const char *s = EXPR_ARG(0);
        const char *b = s; const char *e = s + strlen(s);
        char *r; size_t n;
        int lt = (script_stringcasecmp(name, "rtrim") != 0);
        int rt = (script_stringcasecmp(name, "ltrim") != 0);
        if (lt) while (*b == ' ' || *b == '\t' || *b == '\r' || *b == '\n') b++;
        if (rt) while (e > b && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r' || e[-1] == '\n')) e--;
        n = (size_t)(e - b);
        r = (char *)malloc(n + 1);
        if (r) { memcpy(r, b, n); r[n] = '\0'; }
        return r ? r : expr_strdup("");
    }
    if (script_stringcasecmp(name, "left") == 0)
    {
        const char *s = EXPR_ARG(0); long n = expr_to_long(EXPR_ARG(1));
        size_t sl = strlen(s); char *r;
        if (n < 0) n = 0; if ((size_t)n > sl) n = (long)sl;
        r = (char *)malloc((size_t)n + 1);
        if (r) { memcpy(r, s, (size_t)n); r[n] = '\0'; }
        return r ? r : expr_strdup("");
    }
    if (script_stringcasecmp(name, "right") == 0)
    {
        const char *s = EXPR_ARG(0); long n = expr_to_long(EXPR_ARG(1));
        size_t sl = strlen(s);
        if (n < 0) n = 0; if ((size_t)n > sl) n = (long)sl;
        return expr_strdup(s + (sl - (size_t)n));
    }
    if (script_stringcasecmp(name, "substr") == 0 || script_stringcasecmp(name, "mid") == 0)
    {
        const char *s = EXPR_ARG(0); size_t sl = strlen(s);
        long start = expr_to_long(EXPR_ARG(1));
        long len = (nargs >= 3) ? expr_to_long(EXPR_ARG(2)) : (long)sl;
        char *r;
        if (start < 0) start = 0;
        if ((size_t)start >= sl) return expr_strdup("");
        if (len < 0) len = 0;
        if ((size_t)(start + len) > sl) len = (long)(sl - (size_t)start);
        r = (char *)malloc((size_t)len + 1);
        if (r) { memcpy(r, s + start, (size_t)len); r[len] = '\0'; }
        return r ? r : expr_strdup("");
    }
    if (script_stringcasecmp(name, "find") == 0 || script_stringcasecmp(name, "instr") == 0)
    {
        const char *s = EXPR_ARG(0); const char *sub = EXPR_ARG(1);
        const char *hit = (*sub) ? strstr(s, sub) : s;
        return expr_from_long(hit ? (long)(hit - s) : -1L);
    }
    if (script_stringcasecmp(name, "replace") == 0)
    {
        const char *s = EXPR_ARG(0), *from = EXPR_ARG(1), *to = EXPR_ARG(2);
        script_buffer sb; char *r; size_t fl = strlen(from);
        if (fl == 0) return expr_strdup(s);
        script_buffer_init(&sb);
        while (*s)
        {
            if (strncmp(s, from, fl) == 0) { script_buffer_append_string(&sb, to); s += fl; }
            else script_buffer_append_char(&sb, *s++);
        }
        r = expr_strdup(sb.data ? sb.data : "");
        script_buffer_free(&sb);
        return r;
    }
    if (script_stringcasecmp(name, "repeat") == 0)
    {
        const char *s = EXPR_ARG(0); long n = expr_to_long(EXPR_ARG(1)); long i;
        script_buffer sb; char *r;
        script_buffer_init(&sb);
        for (i = 0; i < n && i < 10000; i++) script_buffer_append_string(&sb, s);
        r = expr_strdup(sb.data ? sb.data : "");
        script_buffer_free(&sb);
        return r;
    }
    if (script_stringcasecmp(name, "pad") == 0)
    {
        const char *s = EXPR_ARG(0); long w = expr_to_long(EXPR_ARG(1));
        size_t sl = strlen(s); script_buffer sb; char *r;
        script_buffer_init(&sb);
        script_buffer_append_string(&sb, s);
        while ((long)sl < w) { script_buffer_append_char(&sb, ' '); sl++; }
        r = expr_strdup(sb.data ? sb.data : "");
        script_buffer_free(&sb);
        return r;
    }
    if (script_stringcasecmp(name, "chr") == 0)
    {
        char b[2]; b[0] = (char)(expr_to_long(EXPR_ARG(0)) & 0xFF); b[1] = '\0';
        return expr_strdup(b);
    }
    if (script_stringcasecmp(name, "asc") == 0)
        return expr_from_long((long)(unsigned char)EXPR_ARG(0)[0]);
    if (script_stringcasecmp(name, "str") == 0 || script_stringcasecmp(name, "val") == 0 ||
        script_stringcasecmp(name, "int") == 0)
        return expr_from_long(expr_to_long(EXPR_ARG(0)));
    if (script_stringcasecmp(name, "abs") == 0)
    { long v = expr_to_long(EXPR_ARG(0)); return expr_from_long(v < 0 ? -v : v); }
    if (script_stringcasecmp(name, "min") == 0)
    { long a = expr_to_long(EXPR_ARG(0)), b = expr_to_long(EXPR_ARG(1)); return expr_from_long(a < b ? a : b); }
    if (script_stringcasecmp(name, "max") == 0)
    { long a = expr_to_long(EXPR_ARG(0)), b = expr_to_long(EXPR_ARG(1)); return expr_from_long(a > b ? a : b); }
    if (script_stringcasecmp(name, "rand") == 0)
    {
        long lo = expr_to_long(EXPR_ARG(0)), hi = expr_to_long(EXPR_ARG(1));
        if (hi < lo) { long t = lo; lo = hi; hi = t; }
        return expr_from_long(lo + (long)(rand() % (hi - lo + 1)));
    }

    /* not a core builtin - try the extended (data/file/KV) set */
    return script_expr_call_function_ext(state, name, args, nargs, handled);
}

/* ---- ScriptData helpers: sandboxed file store under <Converse$Dir>.ScriptData ---- */
static void script_data_dir(char *out, size_t outsz, const char *sub)
{
    if (sub && *sub) snprintf(out, outsz, "<Converse$Dir>.ScriptData.%s", sub);
    else            snprintf(out, outsz, "<Converse$Dir>.ScriptData");
}

static void script_ensure_dir(const char *path)
{
    _kernel_swi_regs regs;
    regs.r[0] = 8;                 /* OS_File 8: create directory */
    regs.r[1] = (int)path;
    regs.r[4] = 0;
    _kernel_swi(0x08, &regs, &regs);
}

/* Build a sandboxed leaf path; the caller-supplied name is reduced to a safe
 * single leaf (alnum/_/- only) so a script cannot escape ScriptData. */
static void script_data_path(char *out, size_t outsz, const char *sub, const char *name)
{
    char dir[256];
    char leaf[128];
    size_t i, j = 0;
    for (i = 0; name && name[i] && j < sizeof(leaf) - 1; i++)
    {
        char ch = name[i];
        if ((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') ||
            (ch >= '0' && ch <= '9') || ch == '_' || ch == '-')
            leaf[j++] = ch;
        else
            leaf[j++] = '_';
    }
    leaf[j] = '\0';
    if (j == 0) { leaf[0] = '_'; leaf[1] = '\0'; }
    script_data_dir(dir, sizeof(dir), sub);
    snprintf(out, outsz, "%s.%s", dir, leaf);
}

static char *script_file_read_all(const char *path)
{
    FILE *f = fopen(path, "rb");
    char *buf;
    long sz;
    if (f == NULL) return NULL;
    fseek(f, 0, SEEK_END); sz = ftell(f); fseek(f, 0, SEEK_SET);
    if (sz < 0) sz = 0;
    if (sz > 1024L * 1024L) sz = 1024L * 1024L;   /* 1 MB cap */
    buf = (char *)malloc((size_t)sz + 1);
    if (buf != NULL)
    {
        size_t rd = fread(buf, 1, (size_t)sz, f);
        buf[rd] = '\0';
    }
    fclose(f);
    return buf;
}

static int script_file_write_data(const char *path, const char *data, int append)
{
    FILE *f = fopen(path, append ? "ab" : "wb");
    if (f == NULL) return 0;
    if (data && *data) fwrite(data, 1, strlen(data), f);
    fclose(f);
    return 1;
}

