/* PROMPT/READLINE command completion */
static int input_complete_prompt(script_state *state)
{
    /* Store the input in the target variable */
    script_set_variable_value(state, state->input_target, state->input_buffer);
    state->more_line_count = 0;  /* Reset line count after input */
    script_clear_input(state);
    state->status = SCRIPT_STATUS_RUNNING;
    script_process(state);
    return 1;
}

/* ANYKEY command completion - any key was pressed */
static int input_complete_anykey(script_state *state)
{
    script_clear_input(state);
    state->status = SCRIPT_STATUS_RUNNING;
    script_process(state);
    return 1;
}

/* Parse an `on` item's arg2 into gates + action (verb/target). */
static void menu_parse_on(const char *arg2, int *lvl, char *rk, size_t rksz,
                          char *pw, size_t pwsz, char *fail, size_t fsz,
                          char *verb, size_t vsz, char *target, size_t tsz,
                          char *help, size_t hsz)
{
    char work[512];
    char *p, *tok;
    *lvl = 0;
    rk[0] = pw[0] = fail[0] = verb[0] = target[0] = '\0';
    if (help != NULL && hsz > 0) help[0] = '\0';
    strncpy(work, arg2 != NULL ? arg2 : "", sizeof(work) - 1);
    work[sizeof(work) - 1] = '\0';
    p = work;
    while (script_arg_next(&p, &tok))
    {
        if (script_stringcasecmp(tok, "level") == 0) { if (script_arg_next(&p, &tok)) *lvl = atoi(tok); }
        else if (script_stringcasecmp(tok, "keys") == 0) { if (script_arg_next(&p, &tok)) { strncpy(rk, tok, rksz - 1); rk[rksz - 1] = '\0'; } }
        else if (script_stringcasecmp(tok, "password") == 0) { if (script_arg_next(&p, &tok)) { strncpy(pw, tok, pwsz - 1); pw[pwsz - 1] = '\0'; } }
        else if (script_stringcasecmp(tok, "fail") == 0) { if (script_arg_next(&p, &tok)) { strncpy(fail, tok, fsz - 1); fail[fsz - 1] = '\0'; } }
        else if (script_stringcasecmp(tok, "help") == 0) { if (script_arg_next(&p, &tok) && help != NULL && hsz > 0) { strncpy(help, tok, hsz - 1); help[hsz - 1] = '\0'; } }
        else if (script_stringcasecmp(tok, "goto") == 0 || script_stringcasecmp(tok, "call") == 0 ||
                 script_stringcasecmp(tok, "script") == 0)
        {
            strncpy(verb, tok, vsz - 1); verb[vsz - 1] = '\0';
            if (script_arg_next(&p, &tok)) { strncpy(target, tok, tsz - 1); target[tsz - 1] = '\0'; }
            break;
        }
    }
}

/* Perform a menu item's action. Returns 1 if it took control (caller returns);
 * 0 means fall through to a redisplay. */
static int menu_dispatch_action(script_state *state, const char *verb, const char *target, size_t menu_idx)
{
    if (script_stringcasecmp(verb, "goto") == 0)
    {
        int found = 0;
        size_t pc = script_find_label(state, target, &found);
        if (found) { state->program_counter = pc; state->status = SCRIPT_STATUS_RUNNING; script_process(state); return 1; }
        return 0;
    }
    if (verb[0] != '\0')   /* script / call : run a sub-script, return to menu */
    {
        char path[256];
        script_expand_macros(state, target, path, sizeof(path));
        if (path[0] != '\0')
        {
            state->program_counter = menu_idx;   /* on subscript return, re-run the menu */
            if (script_push_call_stack(state))
            {
                state->instruction_capacity = SCRIPT_DEFAULT_INSTRUCTION_CAPACITY;
                state->instructions = (script_instruction *)calloc(state->instruction_capacity, sizeof(script_instruction));
                state->label_capacity = SCRIPT_DEFAULT_LABEL_CAPACITY;
                state->labels = (script_label *)calloc(state->label_capacity, sizeof(script_label));
                if (state->instructions != NULL && state->labels != NULL && script_start(state, path))
                { script_process(state); return 1; }
                script_pop_call_stack(state);
            }
        }
    }
    return 0;
}

/* Redraw the active menu screen and wait for another key. */
static void menu_redisplay(script_state *state)
{
    state->program_counter = state->menu_instr_index;
    state->status = SCRIPT_STATUS_RUNNING;
    script_process(state);
}

/* Native menu: a key was pressed. Scan the `on` items following the active
 * `menu` instruction, gate-check, and dispatch (goto = leave the menu; script/
 * call = run a sub-script then return to the menu). A `password` gate prompts
 * for a password first (input_complete_menu_pw resumes the dispatch). Anything
 * else (no match, denied, missing target) redisplays the menu. */
static int input_complete_menu(script_state *state)
{
    char key = (state->input_buffer != NULL && state->input_length > 0) ? state->input_buffer[0] : '\0';
    size_t menu_idx = state->menu_instr_index;
    size_t i;

    script_clear_input(state);

    /* '?' lists context help: every `on` item that carries a `help "..."` token,
       shown as key + help text. Then the menu redisplays. */
    if (key == '?')
    {
        size_t j;
        int shown = 0;
        script_write_output(state, "\r\n");
        for (j = menu_idx + 1; j < state->instruction_count; ++j)
        {
            script_instruction *hins = &state->instructions[j];
            int hl; char hk[32], hp2[64], hf[160], hv[16], ht[256], hh[160];
            if (hins->type == SCRIPT_CMD_ENDMENU) break;
            if (hins->type != SCRIPT_CMD_ON || hins->arg1 == NULL || hins->arg1[0] == '\0') continue;
            menu_parse_on(hins->arg2, &hl, hk, sizeof(hk), hp2, sizeof(hp2), hf, sizeof(hf),
                          hv, sizeof(hv), ht, sizeof(ht), hh, sizeof(hh));
            if (hh[0] == '\0') continue;
            {
                char hline[240];
                snprintf(hline, sizeof(hline), "  \033[1;37m%c\033[0m  %s\r\n", hins->arg1[0], hh);
                script_write_output(state, hline);
                shown++;
            }
        }
        if (!shown)
            script_write_output(state, "  No help available for this menu.\r\n");
        menu_redisplay(state);
        return 1;
    }

    for (i = menu_idx + 1; i < state->instruction_count; ++i)
    {
        script_instruction *ins = &state->instructions[i];
        int need_level;
        char reqkeys[32], reqpw[64], failmsg[160], verb[16], target[256];
        int denied = 0;

        if (ins->type == SCRIPT_CMD_ENDMENU) break;
        if (ins->type != SCRIPT_CMD_ON || ins->arg1 == NULL || ins->arg1[0] == '\0') continue;
        if (tolower((unsigned char)ins->arg1[0]) != tolower((unsigned char)key)) continue;

        menu_parse_on(ins->arg2, &need_level, reqkeys, sizeof(reqkeys), reqpw, sizeof(reqpw),
                      failmsg, sizeof(failmsg), verb, sizeof(verb), target, sizeof(target), NULL, 0);

        if (need_level > 0)
        {
            int lvl = state->host.get_user_accesslevel ? state->host.get_user_accesslevel(state->host.context) : 0;
            if (lvl < need_level) denied = 1;
        }
        if (!denied && reqkeys[0] != '\0')
        {
            const char *uk = state->host.get_user_keys ? state->host.get_user_keys(state->host.context) : "";
            const char *k;
            for (k = reqkeys; *k; ++k) { if (uk == NULL || strchr(uk, *k) == NULL) { denied = 1; break; } }
        }

        if (denied)
        {
            if (failmsg[0] != '\0')
            {
                char fexp[SCRIPT_EXPAND_BUFFER_SIZE];
                script_expand_macros(state, failmsg, fexp, sizeof(fexp));
                script_write_output(state, "\r\n");
                script_write_output(state, fexp);
                script_write_output(state, "\r\n");
            }
            break;  /* -> redisplay */
        }

        if (reqpw[0] != '\0')   /* password gate: prompt, then verify + dispatch */
        {
            state->menu_pw_item = (int)i;
            script_write_output(state, "\r\nPassword: ");
            script_begin_input(state, SCRIPT_INPUT_MODE_LINE_NOECHO, SCRIPT_INPUT_CTX_MENU_PW);
            return 1;
        }

        if (menu_dispatch_action(state, verb, target, menu_idx)) return 1;
        break; /* action failed -> redisplay */
    }

    menu_redisplay(state);
    return 1;
}

/* Password entered for a gated menu item: verify then dispatch, else deny. */
static int input_complete_menu_pw(script_state *state)
{
    char entered[64];
    size_t menu_idx = state->menu_instr_index;
    int idx = state->menu_pw_item;
    state->menu_pw_item = -1;

    strncpy(entered, (state->input_buffer != NULL && state->input_length > 0) ? state->input_buffer : "",
            sizeof(entered) - 1);
    entered[sizeof(entered) - 1] = '\0';
    script_clear_input(state);

    if (idx >= 0 && (size_t)idx < state->instruction_count && state->instructions[idx].type == SCRIPT_CMD_ON)
    {
        int need_level;
        char reqkeys[32], reqpw[64], failmsg[160], verb[16], target[256];
        menu_parse_on(state->instructions[idx].arg2, &need_level, reqkeys, sizeof(reqkeys),
                      reqpw, sizeof(reqpw), failmsg, sizeof(failmsg), verb, sizeof(verb), target, sizeof(target), NULL, 0);
        if (reqpw[0] != '\0' && strcmp(entered, reqpw) == 0)
        {
            if (menu_dispatch_action(state, verb, target, menu_idx)) return 1;
        }
        else
        {
            script_write_output(state, "\r\n\033[1;31mIncorrect password.\033[0m\r\n");
        }
    }

    menu_redisplay(state);
    return 1;
}

/* More prompt completion - user pressed a key */
static int input_complete_more(script_state *state)
{
    char key = (state->input_length > 0) ? state->input_buffer[0] : 0;
    
    /* Clear the "More?" prompt from the line */
    if (state->host.write_text != NULL)
    {
        state->host.write_text(state->host.context, "\r\033[K");
    }
    
    /* Check for quit/abort keys */
    if (key == 'q' || key == 'Q' || key == 'n' || key == 'N' || key == 3)  /* 3 = Ctrl+C */
    {
        /* User wants to stop - disable more for this session */
        state->more_override = 0;
        state->more_line_count = 0;
        /* Discard pending text */
        free(state->more_pending_text);
        state->more_pending_text = NULL;
    }
    else
    {
        /* Continue - reset line counter for next page */
        state->more_line_count = 0;
        
        /* Output the pending text that triggered the More? prompt */
        if (state->more_pending_text != NULL && state->host.write_text != NULL)
        {
            state->host.write_text(state->host.context, state->more_pending_text);
            state->more_line_count = script_count_newlines(state->more_pending_text);
            free(state->more_pending_text);
            state->more_pending_text = NULL;
        }
    }
    
    script_clear_input(state);
    state->status = SCRIPT_STATUS_RUNNING;
    script_process(state);
    return 1;
}

