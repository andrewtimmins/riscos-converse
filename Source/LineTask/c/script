static void script_move_cursor(script_state *state, const char *col_text, const char *row_text)
{
    int column = (col_text != NULL) ? atoi(col_text) : 1;
    int row = (row_text != NULL) ? atoi(row_text) : 1;
    char sequence[32];

    if (state == NULL)
