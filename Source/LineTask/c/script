    if (script_stringcasecmp(token, "sendmail") == 0)
    {
        /* SENDMAIL <username> <subject> <body>  (subject/body backtick-quoted).
           Args parsed here (backtick-aware) and macro-expanded at execute. */
        char *rest = strtok(NULL, "");
        char *a1 = NULL, *a2 = NULL, *a3 = NULL;
        char *p = rest;

        script_arg_next(&p, &a1);
        script_arg_next(&p, &a2);
        script_arg_next(&p, &a3);

        instruction->type = SCRIPT_CMD_SENDMAIL;
        instruction->arg1 = (a1 != NULL) ? a1 : script_duplicate_string("");
        instruction->arg2 = (a2 != NULL) ? a2 : script_duplicate_string("");
        instruction->arg3 = (a3 != NULL) ? a3 : script_duplicate_string("");
