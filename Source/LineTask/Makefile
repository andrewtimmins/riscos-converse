# Make file for LineTask

COMPONENT   = Line
OBJS        = ansiterm chat version crc debug door_arcbbs door_native door_riscbbs filebase main messagebase pipes script transfer xmodem ymodem zmodem
LIBS        = C:Desk.o.Desk TCPIPLibs:o.Socklib TCPIPLibs:o.Inetlib OSLib:o.OSLib32
CFLAGS      = -c -depend !Depend -I,C:,TCPIPLibs: -apcs 3/32bit -Wcdp -throwback -fan
OBJASMFLAGS = -throwback -NoCache -depend !Depend
# amu imposes a 255-char command limit. The full "link -o Line <objs> <libs>"
# line exceeds it once ymodem is added, so amu silently fails to link and ships
# a stale binary. Take over the release link (CUSTOMLINK) and pass the object /
# library list through a response file (LinkVia) so the command stays short.
CUSTOMLINK  = custom
include CApp

# Custom release link via response file (see CUSTOMLINK note above).
${TARGET}: ${APP_OBJS_} ${APP_LIBS} ${DIRS} LinkVia
	${LD} ${LDFLAGS} -o ${TARGET} -via LinkVia
	${SQZ} ${SQZFLAGS} ${TARGET}

clean::
	${WIPE} ${INSTAPP} ${WFLAGS}

