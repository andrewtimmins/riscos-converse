#include <stdio.h>
#include <string.h>
#include <time.h>

#include "linestate.h"

static LINE_STATE line_states[LINESTATE_MAX_LINES];

/* Multi-node chat room (see the chat section below for the SWI handler). */
static char  chat_ring[CHAT_RING_SIZE][CHAT_MSG_LEN];
static long  chat_seq;                          /* seq of the most recent message (0 = none yet) */
static int   chat_in_room[LINESTATE_MAX_LINES];
static long  chat_last_seen[LINESTATE_MAX_LINES];
static char  chat_nick[LINESTATE_MAX_LINES][CHAT_NICK_LEN];

/* InterBBS league score table (see the league section below for the SWI
   handler). In-RMA and volatile for now; the FTN mailer owns the on-disk copy
   and re-populates this via LEAGUE_REASON_IMPORT at startup. */
static LEAGUE_ENTRY league_table[LEAGUE_MAX_ENTRIES];
static int          league_count;               /* contiguous: entries [0..count) are used */

/* Static helpers */
static int linestate_valid_line(int line);
static void league_merge(const char *key, const char *player, const char *board, int score);
static void league_sort(void);

/* ******************************************************************************************************************************************************** */
/* Initialisation and Finalisation                                                                                                                          */
/* ******************************************************************************************************************************************************** */

void linestate_initialise(void)
{
    int i;

    for (i = 0; i < LINESTATE_MAX_LINES; i++)
    {
        memset(&line_states[i], 0, sizeof(LINE_STATE));
        chat_in_room[i] = 0;
        chat_last_seen[i] = 0;
        chat_nick[i][0] = '\0';
    }
    chat_seq = 0;
    memset(chat_ring, 0, sizeof(chat_ring));
    memset(league_table, 0, sizeof(league_table));
    league_count = 0;
}

void linestate_finalise(void)
{
    /* Nothing to clean up */
}

/* ******************************************************************************************************************************************************** */
/* SWI Handlers                                                                                                                                             */
/* ******************************************************************************************************************************************************** */

void linestate_swi_handler(_kernel_swi_regs *r)
{
    LINE_REASON reason;
    int line;
    LINE_FIELD field;

    if (r == NULL)
    {
        return;
    }

    reason = (LINE_REASON)r->r[0];
    line = r->r[1];

    if (!linestate_valid_line(line))
    {
        r->r[0] = -1;
        return;
    }

    field = (LINE_FIELD)r->r[2];

    switch (reason)
    {
        case LINE_REASON_SET:
        {
            switch (field)
            {
                case LINE_FIELD_CONFIGURED:
                    line_states[line].configured = r->r[3];
                    r->r[0] = 0;
                    break;

                case LINE_FIELD_CONNECTED:
                    line_states[line].connected = r->r[3];
                    /* If disconnecting, clear other state */
                    if (r->r[3] == 0)
                    {
                        line_states[line].user_id = 0;
                        line_states[line].transfer_active = 0;
                        line_states[line].connect_time = 0;
                        line_states[line].activity[0] = '\0';
                        line_states[line].hostname[0] = '\0';
                    }
                    r->r[0] = 0;
                    break;

                case LINE_FIELD_USER_ID:
                    line_states[line].user_id = r->r[3];
                    r->r[0] = 0;
                    break;

                case LINE_FIELD_CONNECT_TIME:
                    line_states[line].connect_time = (time_t)r->r[3];
                    r->r[0] = 0;
                    break;

                case LINE_FIELD_HOSTNAME:
                {
                    const char *hostname = (const char *)r->r[3];
                    if (hostname != NULL)
                    {
                        snprintf(line_states[line].hostname, sizeof(line_states[line].hostname), "%s", hostname);
                    }
                    else
                    {
                        line_states[line].hostname[0] = '\0';
                    }
                    r->r[0] = 0;
                    break;
                }

                case LINE_FIELD_TRANSFER:
                    line_states[line].transfer_active = r->r[3];
                    r->r[0] = 0;
                    break;

                case LINE_FIELD_TYPE:
                    line_states[line].line_type = r->r[3];
                    r->r[0] = 0;
                    break;

                default:
                    r->r[0] = -1;
                    break;
            }
            break;
        }

        case LINE_REASON_GET:
        {
            switch (field)
            {
                case LINE_FIELD_CONFIGURED:
                    r->r[0] = line_states[line].configured;
                    break;

                case LINE_FIELD_CONNECTED:
                    r->r[0] = line_states[line].connected;
                    break;

                case LINE_FIELD_USER_ID:
                    r->r[0] = line_states[line].user_id;
                    break;

                case LINE_FIELD_CONNECT_TIME:
                    r->r[0] = (int)line_states[line].connect_time;
                    break;

                case LINE_FIELD_HOSTNAME:
                    r->r[0] = (int)line_states[line].hostname;
                    break;

                case LINE_FIELD_TRANSFER:
                    r->r[0] = line_states[line].transfer_active;
                    break;

                case LINE_FIELD_TYPE:
                    r->r[0] = line_states[line].line_type;
                    break;

                default:
                    r->r[0] = -1;
                    break;
            }
            break;
        }

        default:
            r->r[0] = -1;
            break;
    }
}

void activity_swi_handler(_kernel_swi_regs *r)
{
    ACTIVITY_REASON reason;
    int line;

    if (r == NULL)
    {
        return;
    }

    reason = (ACTIVITY_REASON)r->r[0];
    line = r->r[1];

    if (!linestate_valid_line(line))
    {
        r->r[0] = -1;
        return;
    }

    switch (reason)
    {
        case ACTIVITY_REASON_SET:
        {
            const char *text = (const char *)r->r[2];
            if (text != NULL)
            {
                snprintf(line_states[line].activity, sizeof(line_states[line].activity), "%s", text);
            }
            else
            {
                line_states[line].activity[0] = '\0';
            }
            r->r[0] = 0;
            break;
        }

        case ACTIVITY_REASON_GET:
            r->r[0] = (int)line_states[line].activity;
            break;

        default:
            r->r[0] = -1;
            break;
    }
}

/* ******************************************************************************************************************************************************** */
/* Multi-node chat (teleconference) - single global room                                                                                                    */
/*                                                                                                                                                          */
/* A shared message ring + a monotonic sequence counter live here in the Support */
/* module, so every line process (they are separate LineTask instances) sees one */
/* room. A line JOINs (its last-seen seq is set to "now" so it only sees new      */
/* traffic), POSTs formatted lines, and POLLs to drain messages it hasn't seen.   */
/* ******************************************************************************************************************************************************** */

void chat_swi_handler(_kernel_swi_regs *r)
{
    CHAT_REASON reason;
    int line;

    if (r == NULL)
    {
        return;
    }

    reason = (CHAT_REASON)r->r[0];
    line = r->r[1];

    if (!linestate_valid_line(line))
    {
        r->r[0] = -1;
        return;
    }

    switch (reason)
    {
        case CHAT_REASON_JOIN:
        {
            const char *nick = (const char *)r->r[2];
            chat_in_room[line] = 1;
            chat_last_seen[line] = chat_seq;    /* only see messages from now on */
            if (nick != NULL)
            {
                strncpy(chat_nick[line], nick, CHAT_NICK_LEN - 1);
                chat_nick[line][CHAT_NICK_LEN - 1] = '\0';
            }
            else
            {
                chat_nick[line][0] = '\0';
            }
            r->r[0] = 0;
            break;
        }

        case CHAT_REASON_LEAVE:
            chat_in_room[line] = 0;
            r->r[0] = 0;
            break;

        case CHAT_REASON_POST:
        {
            const char *text = (const char *)r->r[2];
            if (text != NULL)
            {
                long idx;
                chat_seq++;
                idx = (chat_seq - 1) % CHAT_RING_SIZE;
                strncpy(chat_ring[idx], text, CHAT_MSG_LEN - 1);
                chat_ring[idx][CHAT_MSG_LEN - 1] = '\0';
            }
            r->r[0] = 0;
            break;
        }

        case CHAT_REASON_POLL:
        {
            char *buf = (char *)r->r[2];
            int buflen = r->r[3];
            long target = chat_last_seen[line] + 1;
            long oldest;

            if (buf == NULL || buflen <= 0 || target > chat_seq)
            {
                r->r[0] = 0;                    /* nothing new */
                break;
            }

            /* If we have fallen behind the ring, skip to the oldest retained. */
            oldest = chat_seq - CHAT_RING_SIZE + 1;
            if (oldest < 1) oldest = 1;
            if (target < oldest) target = oldest;

            strncpy(buf, chat_ring[(target - 1) % CHAT_RING_SIZE], (size_t)(buflen - 1));
            buf[buflen - 1] = '\0';
            chat_last_seen[line] = target;
            r->r[0] = 1;                        /* delivered one message */
            break;
        }

        case CHAT_REASON_ACTIVE:
            r->r[0] = chat_in_room[line];
            break;

        case CHAT_REASON_NICK:
            r->r[0] = chat_in_room[line] ? (int)chat_nick[line] : 0;
            break;

        default:
            r->r[0] = -1;
            break;
    }
}

/* ******************************************************************************************************************************************************** */
/* InterBBS score league (SWI ConverseBBS_League 0x5AA8A)                                                                                                   */
/* ******************************************************************************************************************************************************** */

/* Merge one (key, player, board) score into the table: keep the player's best
   score per door per board. board=="" is the local board. When the table is
   full, a genuinely higher score evicts the current lowest; otherwise it is
   dropped. Entries are kept contiguous in [0..league_count). */
static void league_merge(const char *key, const char *player, const char *board, int score)
{
    int i, minidx = 0;
    if (key == NULL || player == NULL) return;
    if (board == NULL) board = "";
    if (key[0] == '\0' || player[0] == '\0') return;

    for (i = 0; i < league_count; i++)
    {
        if (strcmp(league_table[i].key, key) == 0 &&
            strcmp(league_table[i].player, player) == 0 &&
            strcmp(league_table[i].board, board) == 0)
        {
            if (score > league_table[i].score) league_table[i].score = score;
            return;                              /* existing entry updated */
        }
        if (league_table[i].score < league_table[minidx].score) minidx = i;
    }

    if (league_count >= LEAGUE_MAX_ENTRIES)
    {
        if (league_count == 0 || score <= league_table[minidx].score) return;  /* full, not better */
        i = minidx;                              /* evict the weakest */
    }
    else
    {
        i = league_count++;                      /* append */
    }

    memset(&league_table[i], 0, sizeof(LEAGUE_ENTRY));
    strncpy(league_table[i].key, key, LEAGUE_KEY_LEN - 1);
    strncpy(league_table[i].player, player, LEAGUE_PLAYER_LEN - 1);
    strncpy(league_table[i].board, board, LEAGUE_BOARD_LEN - 1);
    league_table[i].score = score;
    league_table[i].used = 1;
    league_sort();
}

/* Keep the table ordered by door key (ascending) then score (descending), so a
   reader can walk it, start a new section when the key changes, and rank rows
   within each door top-first. Insertion sort - the table is small. */
static void league_sort(void)
{
    int i, j;
    for (i = 1; i < league_count; i++)
    {
        LEAGUE_ENTRY tmp = league_table[i];
        j = i - 1;
        while (j >= 0)
        {
            int c = strcmp(league_table[j].key, tmp.key);
            if (c < 0 || (c == 0 && league_table[j].score >= tmp.score)) break;
            league_table[j + 1] = league_table[j];
            j--;
        }
        league_table[j + 1] = tmp;
    }
}

void league_swi_handler(_kernel_swi_regs *r)
{
    switch ((LEAGUE_REASON)r->r[0])
    {
        case LEAGUE_REASON_REPORT:
            league_merge((const char *)r->r[1], (const char *)r->r[2], "", (int)r->r[3]);
            r->r[0] = 0;
            break;

        case LEAGUE_REASON_IMPORT:
            league_merge((const char *)r->r[1], (const char *)r->r[2],
                         (const char *)r->r[4], (int)r->r[3]);
            r->r[0] = 0;
            break;

        case LEAGUE_REASON_COUNT:
            r->r[0] = league_count;
            break;

        case LEAGUE_REASON_ENTRY:
        {
            int idx = (int)r->r[1];
            int field = (int)r->r[2];
            char *buf = (char *)r->r[3];
            int buflen = (int)r->r[4];
            const char *src;
            if (idx < 0 || idx >= league_count) { r->r[0] = -1; break; }
            src = field == 1 ? league_table[idx].player :
                  field == 2 ? league_table[idx].board  :
                               league_table[idx].key;
            if (buf != NULL && buflen > 0)
            {
                strncpy(buf, src, (size_t)(buflen - 1));
                buf[buflen - 1] = '\0';
            }
            r->r[0] = league_table[idx].score;
            break;
        }

        case LEAGUE_REASON_CLEAR:
            memset(league_table, 0, sizeof(league_table));
            league_count = 0;
            r->r[0] = 0;
            break;

        default:
            r->r[0] = -1;
            break;
    }
}

/* ******************************************************************************************************************************************************** */
/* Direct Access                                                                                                                                            */
/* ******************************************************************************************************************************************************** */

const LINE_STATE *linestate_get(int line)
{
    if (!linestate_valid_line(line))
    {
        return NULL;
    }

    return &line_states[line];
}

int linestate_count_connected(void)
{
    int count = 0;
    int i;

    for (i = 0; i < LINESTATE_MAX_LINES; i++)
    {
        if (line_states[i].connected)
        {
            count++;
        }
    }

    return count;
}

/* ******************************************************************************************************************************************************** */
/* Static Helpers                                                                                                                                           */
/* ******************************************************************************************************************************************************** */

static int linestate_valid_line(int line)
{
    return (line >= 0 && line < LINESTATE_MAX_LINES);
}
