#ifndef LINESTATE_H
#define LINESTATE_H

#include <time.h>

#include "kernel.h"

#define LINESTATE_MAX_LINES      32
#define LINESTATE_ACTIVITY_LEN   96
#define LINESTATE_HOSTNAME_LEN   64

/* Line state reason codes for SWI ConverseBBS_Line (0x5AA81) */
typedef enum
{
    LINE_REASON_SET = 0,        /* R1=line, R2=field, R3=value */
    LINE_REASON_GET = 1         /* R1=line, R2=field -> R0=value */
} LINE_REASON;

/* Line state fields */
typedef enum
{
    LINE_FIELD_CONFIGURED = 0,  /* int: is line configured? */
    LINE_FIELD_CONNECTED = 1,   /* int: active connection? */
    LINE_FIELD_USER_ID = 2,     /* int: logged-in user ID (0=none) */
    LINE_FIELD_CONNECT_TIME = 3,/* time_t: when connection started */
    LINE_FIELD_HOSTNAME = 4,    /* char*: remote hostname/IP */
    LINE_FIELD_TRANSFER = 5,    /* int: file transfer in progress? */
    LINE_FIELD_TYPE = 6         /* int: line type (0=telnet,1=serial,2=local) */
} LINE_FIELD;

/* Line type values (matches Server's line_type_t) */
#define LINE_TYPE_TELNET    0
#define LINE_TYPE_SERIAL    1
#define LINE_TYPE_LOCAL     2

/* Activity reason codes for SWI ConverseBBS_Activity (0x5AA82) */
typedef enum
{
    ACTIVITY_REASON_SET = 0,    /* R1=line, R2=text string */
    ACTIVITY_REASON_GET = 1     /* R1=line -> R0=text string ptr */
} ACTIVITY_REASON;

/* Multi-node chat (teleconference) - single global room shared across all line
   processes. SWI ConverseBBS_Chat (0x5AA89). Reason codes: */
typedef enum
{
    CHAT_REASON_JOIN   = 0,     /* R1=line, R2=nick ptr: enter room, start seeing new messages */
    CHAT_REASON_LEAVE  = 1,     /* R1=line: leave room */
    CHAT_REASON_POST   = 2,     /* R1=line, R2=text ptr: post a line to the room */
    CHAT_REASON_POLL   = 3,     /* R1=line, R2=buf, R3=buflen -> R0=1 + next unseen msg, or R0=0 */
    CHAT_REASON_ACTIVE = 4,     /* R1=line -> R0 = is this line in the room? */
    CHAT_REASON_NICK   = 5      /* R1=line -> R0 = ptr to that line's nick (in-room only, else NULL) */
} CHAT_REASON;

#define CHAT_RING_SIZE   64     /* messages retained in the shared ring */
#define CHAT_MSG_LEN     200    /* max bytes per posted message */
#define CHAT_NICK_LEN    32     /* max nick length */

/* InterBBS door-score league - a normalised high-score store shared across all
   line processes (and fed by the FTN mailer from peer boards). Doors report a
   score by SWI, so no per-door score-file parsing. SWI ConverseBBS_League
   (0x5AA8A). Reason codes: */
typedef enum
{
    LEAGUE_REASON_REPORT = 0,   /* R1=key ptr, R2=player ptr, R3=score: post a LOCAL score */
    LEAGUE_REASON_IMPORT = 1,   /* R1=key ptr, R2=player ptr, R3=score, R4=board ptr: merge a PEER score */
    LEAGUE_REASON_COUNT  = 2,   /* -> R0 = number of used entries */
    LEAGUE_REASON_ENTRY  = 3,   /* R1=index, R2=field(0=key/1=player/2=board), R3=buf, R4=len -> R0=score */
    LEAGUE_REASON_CLEAR  = 4    /* wipe the table (sysop reset) */
} LEAGUE_REASON;

#define LEAGUE_MAX_ENTRIES  256    /* total (key,player,board) rows retained */
#define LEAGUE_KEY_LEN      24     /* shared door key, e.g. "snake" */
#define LEAGUE_PLAYER_LEN   40
#define LEAGUE_BOARD_LEN    40     /* "" = this (local) board */

typedef struct
{
    char key[LEAGUE_KEY_LEN];
    char player[LEAGUE_PLAYER_LEN];
    char board[LEAGUE_BOARD_LEN];
    int  score;
    int  used;
} LEAGUE_ENTRY;

/* Per-line state structure */
typedef struct
{
    int configured;
    int connected;
    int user_id;
    int transfer_active;
    int line_type;              /* 0=telnet, 1=serial, 2=local */
    time_t connect_time;
    char activity[LINESTATE_ACTIVITY_LEN];
    char hostname[LINESTATE_HOSTNAME_LEN];
} LINE_STATE;

/* Initialisation and finalisation */
void linestate_initialise(void);
void linestate_finalise(void);

/* SWI handlers */
void linestate_swi_handler(_kernel_swi_regs *r);
void activity_swi_handler(_kernel_swi_regs *r);
void chat_swi_handler(_kernel_swi_regs *r);
void league_swi_handler(_kernel_swi_regs *r);

/* Direct access for CLI commands */
const LINE_STATE *linestate_get(int line);
int linestate_count_connected(void);

#endif
