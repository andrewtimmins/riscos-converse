<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Upload - {{bbsname}}</title>
    <link rel="stylesheet" href="/style">
</head>
<body>
    <div class="shell">
        <div class="banner">
            <a class="mark" href="/">THE YELLOW TOASTER<span class="cursor"></span></a>
            <span class="tag">RISC OS &middot; Fidonet 2:250/9</span>
            <span class="spacer"></span>
        </div>
        <nav class="nav">
            <a href="/">Messages</a>
            <a href="/files" class="on">Files</a>
            <span class="spacer"></span>
            <span class="userchip">{{loginform}}</span>
        </nav>
        <div class="crumb"><a href="/">Home</a><span class="sep">&#9656;</span><a href="/files">Files</a><span class="sep">&#9656;</span><span class="here">Upload</span></div>
        <main class="main">
            <div class="screenhead"><span class="arrow">&#9656;</span><h2>Upload a file</h2></div>
            <div class="notice" id="success" style="display:none">&#10003; File uploaded.</div>
            <div class="hint">Max 2&nbsp;MB &middot; pick the filebase and area, and add a short description.</div>
            {{uploadform}}
        </main>
        <div class="status">
            <span><span class="dot">&#9679;</span> online <b>1</b></span>
            <span>node <b>1</b></span>
            <span>addr <b>2:250/9</b></span>
            <span class="spacer"></span>
            <span>files</span>
        </div>
    </div>
    <script>
        if (window.location.search.indexOf('success=1') !== -1) {
            document.getElementById('success').style.display = 'block';
        }
        var filebaseSelect = document.getElementById('filebase');
        var areaSelect = document.getElementById('area');
        if (filebaseSelect && areaSelect) {
            filebaseSelect.addEventListener('change', function() {
                var filebaseId = this.value;
                areaSelect.innerHTML = '<option value="0">-- Loading... --</option>';
                if (!filebaseId || filebaseId === '0') {
                    areaSelect.innerHTML = '<option value="0">-- Select a filebase first --</option>';
                    return;
                }
                fetch('/api/areas?filebase=' + filebaseId)
                    .then(function(response) { return response.json(); })
                    .then(function(areas) {
                        areaSelect.innerHTML = '<option value="0">-- None (uncategorized) --</option>';
                        areas.forEach(function(area) {
                            var opt = document.createElement('option');
                            opt.value = area.id;
                            opt.textContent = area.name;
                            areaSelect.appendChild(opt);
                        });
                    })
                    .catch(function() {
                        areaSelect.innerHTML = '<option value="0">-- None --</option>';
                    });
            });
        }
    </script>
</body>
</html>
