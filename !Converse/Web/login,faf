<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Log in - {{bbsname}}</title>
    <link rel="stylesheet" href="/style">
</head>
<body>
    <div class="shell">
        <div class="banner">
            <a class="mark" href="/">THE YELLOW TOASTER<span class="cursor"></span></a>
            <span class="tag">RISC OS &middot; Fidonet 2:250/9</span>
            <span class="spacer"></span>
        </div>
        <div class="crumb"><a href="/">Home</a><span class="sep">&#9656;</span><span class="here">Log in</span></div>
        <main class="main">
            <div class="auth">
                <h2>Log in</h2>
                <div class="notice priv" id="error" style="display:none">Invalid username or password. Please try again.</div>
                <form class="form" method="POST" action="/login">
                    <div class="field"><label>Username</label><input type="text" name="username" required autofocus></div>
                    <div class="field"><label>Password</label><input type="password" name="password" required></div>
                    <div class="formbar">
                        <a class="btn" href="/">Cancel</a>
                        <button class="btn amber" type="submit">Log in</button>
                    </div>
                </form>
            </div>
        </main>
        <div class="status">
            <span><span class="dot">&#9679;</span> online <b>1</b></span>
            <span>node <b>1</b></span>
            <span>addr <b>2:250/9</b></span>
            <span class="spacer"></span>
            <span>guest &middot; not logged in</span>
        </div>
    </div>
    <script>
        if (window.location.search.indexOf('error=1') !== -1) {
            document.getElementById('error').style.display = 'block';
        }
    </script>
</body>
</html>
