{
   /* Message Bases - declarative menu primitive. `menu` draws the screen and
      runs MsgOverlay (live status strip + base/area + prompt) on each
      (re)display; each `on` routes a key (with a `help` string for '?'). Action
      blocks run then `goto mb_menu` to redisplay; `q` leaves via mb_quit. */

label mb_menu
   menu `<Converse$Dir>.BBS.Screens.MsgMenu` overlay `<Converse$Dir>.BBS.MsgOverlay`
      on `r`  help `Read messages in the current area`   goto mb_read
      on `a`  help `Change message base or area`         goto mb_areas
      on `s`  help `Scan for new posts`                  goto mb_scan
      on `i`  help `Read your private inbox`             goto mb_inbox
      on `p`  help `Post a public message`               goto mb_post
      on `e`  help `Send private email`                  goto mb_email
      on `n`  help `Send FidoNet netmail`                goto mb_netmail
      on `f`  help `Leave feedback for the sysop`        goto mb_feedback
      on `q`  help `Back to the main menu`               goto mb_quit
   endmenu

label mb_read
   cls
   doing `Reading messages...`
   more 0
   messagebase messages
   more 1
   doing
   anykey
   goto mb_menu
label mb_areas
   cls
   messagebase list
   messagebase areas
   goto mb_menu
label mb_scan
   cls
   loginscan
   anykey
   goto mb_menu
label mb_inbox
   cls
   more 0
   messagebase inbox
   more 1
   anykey
   goto mb_menu
label mb_post
   cls
   doing `Composing message...`
   messagebase compose
   doing
   goto mb_menu
label mb_email
   cls
   doing `Composing private mail...`
   messagebase compose private
   doing
   goto mb_menu
label mb_netmail
   cls
   doing `Composing netmail...`
   messagebase compose netmail
   doing
   goto mb_menu
label mb_feedback
   script `<Converse$Dir>.BBS.Feedback`
   goto mb_menu
label mb_quit
   return
}
