{
   /* Message Bases - ANSI. Draws Screens.MsgMenu then dispatches. */

label mb_menu
   type `<Converse$Dir>.BBS.Screens.MsgMenu`
   pos 16 21
   prompt choice char echo

   if choice == `r` goto mb_read
   if choice == `R` goto mb_read
   if choice == `a` goto mb_areas
   if choice == `A` goto mb_areas
   if choice == `s` goto mb_scan
   if choice == `S` goto mb_scan
   if choice == `i` goto mb_inbox
   if choice == `I` goto mb_inbox
   if choice == `p` goto mb_post
   if choice == `P` goto mb_post
   if choice == `e` goto mb_email
   if choice == `E` goto mb_email
   if choice == `n` goto mb_netmail
   if choice == `N` goto mb_netmail
   if choice == `f` goto mb_feedback
   if choice == `F` goto mb_feedback
   if choice == `q` goto mb_quit
   if choice == `Q` goto mb_quit
   goto mb_menu

label mb_read
   cls
   doing `Reading messages...`
   more 0
   messagebase messages
   more 1
   doing
   anykey
   goto mb_menu
label mb_areas
   cls
   messagebase list
   messagebase areas
   goto mb_menu
label mb_scan
   cls
   loginscan
   anykey
   goto mb_menu
label mb_inbox
   cls
   more 0
   messagebase inbox
   more 1
   anykey
   goto mb_menu
label mb_post
   cls
   doing `Composing message...`
   messagebase compose
   doing
   goto mb_menu
label mb_email
   cls
   doing `Composing private mail...`
   messagebase compose private
   doing
   goto mb_menu
label mb_netmail
   cls
   doing `Composing netmail...`
   messagebase compose netmail
   doing
   goto mb_menu
label mb_feedback
   script `<Converse$Dir>.BBS.Feedback`
   goto mb_menu
label mb_quit
   return
}
