{
   /* Message Bases - declarative menu primitive. `menu` draws the screen and
      runs MsgOverlay (live status strip + base/area + prompt) on each
      (re)display; each `on` routes a key (with a `help` string for '?'). Action
      blocks run then `goto mb_menu` to redisplay; `q` leaves via mb_quit. */

label mb_menu
   menu `<Converse$Dir>.BBS.Screens.MsgMenu` overlay `<Converse$Dir>.BBS.MsgOverlay`
      on `r`  at 6 13  text `Read messages`  help `Read messages in the current area`   goto mb_read
      on `a`  at 6 14  text `Change area`    help `Change message base or area`         goto mb_areas
      on `s`  at 6 15  text `Scan new posts` help `Scan for new posts`                  goto mb_scan
      on `i`  at 6 16  text `Your inbox`     help `Read your private inbox`             goto mb_inbox
      on `p`  at 32 13 text `Post public`    help `Post a public message`               goto mb_post
      on `e`  at 32 14 text `Private email`  help `Send private email`                  goto mb_email
      on `n`  at 32 15 text `Netmail`        help `Send FidoNet netmail`                goto mb_netmail
      on `f`  at 32 16 text `Feedback`       help `Leave feedback for the sysop`        goto mb_feedback
      on `q`  at 57 13 text `Back to main`   help `Back to the main menu`               goto mb_quit
   endmenu

label mb_read
   cls
   more 0
   messagebase browse
   more 1
   goto mb_menu
label mb_areas
   cls
   messagebase list
   messagebase areas
   goto mb_menu
label mb_scan
   cls
   loginscan
   anykey
   goto mb_menu
label mb_inbox
   cls
   more 0
   messagebase inbox
   more 1
   anykey
   goto mb_menu
label mb_post
   cls
   doing `Composing message...`
   messagebase compose
   doing
   /* status points: bump the poster's post counter (global KV, keyed by id) */
   set ppid = userget(`id`)
   set ppr = kvset(`pts_` + ppid + `_posts`, int(kvget(`pts_` + ppid + `_posts`)) + 1)
   goto mb_menu
label mb_email
   cls
   doing `Composing private mail...`
   messagebase compose private
   doing
   goto mb_menu
label mb_netmail
   cls
   doing `Composing netmail...`
   messagebase compose netmail
   doing
   goto mb_menu
label mb_feedback
   script `<Converse$Dir>.BBS.Feedback`
   goto mb_menu
label mb_quit
   return
}
