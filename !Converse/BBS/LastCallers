{
   /* Last Callers - walk the KV ring buffer most-recent-first and overlay the
      table onto the boxed Screens.LastCall. Postlogon records each caller into
      lc_0..lc_9 (a 10-slot ring) with lc_count as the running total. */

   type `<Converse$Dir>.BBS.Screens.LastCall`
   set esc = chr(27)
   set count = val( kvget(`lc_count`) )
   set shown = count
   if shown > 10 then
      set shown = 10
   endif
   set i = 0
label lc_loop
   if i >= shown goto lc_done
   set idx = count - 1 - i
   set slot = idx - (idx / 10) * 10
   set rec = kvget(`lc_` + slot)
   if rec == `` goto lc_next
   set p1 = find(rec, `|`)
   set uname = left(rec, p1)
   set rest = substr(rec, p1 + 1)
   set p2 = find(rest, `|`)
   set rname = left(rest, p2)
   set when = substr(rest, p2 + 1)
   set row = 14 + i
   set seq = esc + `[` + str(row) + `;6H`
   print `%{seq}`
   fg 15
   print `%{ =pad(uname,16) }`
   fg 7
   print `%{ =pad(rname,26) }`
   fg 6
   print `%{when}`
label lc_next
   set i = i + 1
   goto lc_loop
label lc_done
   std
   anykey
   return
}
