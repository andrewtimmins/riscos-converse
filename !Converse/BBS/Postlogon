{
   /* Post-logon: record this call into the last-callers ring, then run the
      classic login sequence - news, last callers, new-scan. A quick-login
      (username prefixed with '!') skips straight to the menu. */

   /* status-points score for a user by directory index (matches Profiles upts) */
   function upts(idx)
      local id = userbyindex(idx, `id`)
      local base = userbyindex(idx, `calls`) * 2 + userbyindex(idx, `uploads`) * 25 + userbyindex(idx, `uploadskb`) / 50
      return base + int(kvget(`pts_` + id + `_posts`)) * 10 + int(kvget(`pts_` + id + `_bonus`))
   endfunction

   /* record into the 10-slot ring: lc_<slot> = user|realname|when, lc_count++ */
   set lcn = val( kvget(`lc_count`) )
   set slot = lcn - (lcn / 10) * 10
   set nowstr %{date} %{time}
   set junk = kvset(`lc_` + slot, userget(`username`) + `|` + userget(`realname`) + `|` + nowstr)
   set junk = kvset(`lc_count`, lcn + 1)

   cls
   if quicklogin == 1 goto quick
   type `<Converse$Dir>.BBS.Screens.Bulletins`
   anykey
   script `<Converse$Dir>.BBS.LastCallers`
   cls
   doing `Scanning for new content...`
   loginscan
   doing
   anykey

   /* status points + rank */
   set myid = userget(`id`)
   set mypts = userget(`calls`) * 2 + userget(`uploads`) * 25 + userget(`uploadskb`) / 50 + int(kvget(`pts_` + myid + `_posts`)) * 10 + int(kvget(`pts_` + myid + `_bonus`))
   set total = usercount()
   set rank = 1
   set ri = 0
   while ri < total
      if upts(ri) > mypts then
         set rank = rank + 1
      endif
      set ri = ri + 1
   endwhile
   set esc = chr(27)
   set nl = chr(13) + chr(10)
   set ptsline = nl + esc + `[1;33m  You have ` + mypts + ` points` + esc + `[0m` + esc + `[0;36m   (rank #` + rank + ` of ` + total + `)` + esc + `[0m` + nl
   print %{ptsline}
   anykey
label quick
   script `<Converse$Dir>.BBS.MainMenu`
}
