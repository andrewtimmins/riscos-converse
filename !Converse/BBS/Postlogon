{
   /* Post-logon: the classic login sequence - news, last callers, new-scan.
      A quick-login (username prefixed with '!') skips straight to the menu. */
   cls
   if quicklogin == 1 goto quick
   type `<Converse$Dir>.BBS.Screens.Bulletins`
   anykey
   type `<Converse$Dir>.BBS.Screens.LastCall`
   anykey
   cls
   doing `Scanning for new content...`
   loginscan
   doing
   anykey
label quick
   script `<Converse$Dir>.BBS.MainMenu`
}
