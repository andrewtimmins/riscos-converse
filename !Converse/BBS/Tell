{
   /* Tell a User - send a one-line message to another online caller via
      notifyuser(), overlaid on the boxed Screens.Tell. */

   type `<Converse$Dir>.BBS.Screens.Tell`
   pos 33 6
   fg 15
   print `%{onlineusers}`
   std
   pos 17 10
   fg 15
   readline who
   std
   if who == `` goto tell_cancel
   pos 17 11
   fg 15
   readline msg
   std
   if msg == `` goto tell_cancel

   set sent = notifyuser(who, `*** Message from ` + userget(`realname`) + `: ` + msg)
   if ok == 1 goto tell_ok
   pos 7 24
   fg 12
   print `That user isn't online (or wasn't found).  Press ENTER.`
   std
   prompt k char
   return

label tell_ok
   pos 7 24
   fg 10
   print `Delivered!  Press ENTER.`
   std
   prompt k char
   return

label tell_cancel
   return
}
