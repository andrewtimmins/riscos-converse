{
   /* Doors & Games - declarative menu primitive. `menu` draws the screen and
      runs DoorsOverlay (status strip + prompt) on each (re)display; each `on`
      routes a number to a door with a `help` string for '?'. Action blocks
      launch the door then `goto doors_menu` to redisplay; `q` leaves.
      Doors are launched by TYPE (verified against each door's binary/config):
        RiscBBS (Wimp task &4B534154, gets the line via %{line} as %*0):
          Tetris, Breakout (Carl Declerck) + Purity, Wall.
          `call riscbbsdoor \`<path>.!Run %{line}\``
        ArcBBS (Richard Paddle, polls the ARCbbsDoors module for its DoorNumber
          from its own Config - no line param): Snake=4, Boxed=5, Trivia=6.
          `call arcbbsdoor <DoorNumber> \`<path>.!Run\`` */

label doors_menu
   menu `<Converse$Dir>.BBS.Screens.DoorsGm` overlay `<Converse$Dir>.BBS.DoorsOverlay`
      on `1`  at 6 13  text `Tetris`      help `Play Tetris`            goto run_tetris
      on `2`  at 6 14  text `Snake`       help `Play Snake`             goto run_snake
      on `3`  at 6 15  text `Breakout`    help `Play Breakout`          goto run_breakout
      on `4`  at 32 13 text `Boxed In`    help `Play Boxed In`          goto run_boxed
      on `5`  at 32 14 text `Trivia`      help `Play Trivia`            goto run_trivia
      on `6`  at 32 15 text `Purity Test` help `Take the Purity Test`   goto run_purity
      on `7`  at 57 13 text `The Wall`    help `Visit The Wall`         goto run_wall
      on `l`  at 57 14 text `InterBBS League` help `InterBBS league table`  goto run_league
      on `s`  level 500 help `Sync league to peers (sysop)`  goto run_leaguesync
      on `r`  level 500 help `Reset the league table (sysop)` goto run_leaguereset
      on `q`  at 57 15 text `Back to main` help `Back to the main menu`  goto doors_quit
   endmenu

label run_tetris
   doing `Playing Tetris...`
   call riscbbsdoor `<Converse$Dir>.BBS.Doors.!Tetris.!Run %{line}`
   doing
   goto doors_menu
label run_snake
   doing `Playing Snake...`
   call arcbbsdoor 4 `<Converse$Dir>.BBS.Doors.!SnakeDoor.!Run`
   doing
   goto doors_menu
label run_breakout
   doing `Playing Breakout...`
   call riscbbsdoor `<Converse$Dir>.BBS.Doors.!Breakout.!Run %{line}`
   doing
   goto doors_menu
label run_boxed
   doing `Playing Boxed In...`
   call arcbbsdoor 5 `<Converse$Dir>.BBS.Doors.!BoxedDoor.!Run`
   doing
   goto doors_menu
label run_trivia
   doing `Playing Trivia...`
   call arcbbsdoor 6 `<Converse$Dir>.BBS.Doors.!TrivDoor.!Run`
   doing
   goto doors_menu
label run_purity
   doing `Running the Purity Test...`
   call riscbbsdoor `<Converse$Dir>.BBS.Doors.!Purity.!Run %{line}`
   doing
   goto doors_menu
label run_wall
   doing `Visiting The Wall...`
   call riscbbsdoor `<Converse$Dir>.BBS.Doors.!Wall.!Run %{line}`
   doing
   goto doors_menu
label run_league
   script `<Converse$Dir>.BBS.League`
   goto doors_menu
label run_leaguesync
   script `<Converse$Dir>.BBS.LeagueSync`
   goto doors_menu
label run_leaguereset
   script `<Converse$Dir>.BBS.LeagueReset`
   goto doors_menu

label doors_quit
   return
}
