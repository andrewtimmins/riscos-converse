{
   /* Doors & Games - ANSI. Draws Screens.DoorsGm then launches the game. */
   /* Door launch: `call riscbbsdoor <cmd>` starts the door on this line;     */
   /* the door's !Run receives the line number via %*0.                       */

label doors_menu
   type `<Converse$Dir>.BBS.Screens.DoorsGm`
   pos 13 22
   prompt choice char echo

   if choice == `1` goto run_tetris
   if choice == `2` goto run_snake
   if choice == `3` goto run_breakout
   if choice == `4` goto run_boxed
   if choice == `5` goto run_trivia
   if choice == `6` goto run_purity
   if choice == `7` goto run_wall
   if choice == `q` goto doors_quit
   if choice == `Q` goto doors_quit
   goto doors_menu

label run_tetris
   doing `Playing Tetris...`
   call riscbbsdoor `<Converse$Dir>.BBS.Doors.!Tetris.!Run %{line}`
   doing
   goto doors_menu
label run_snake
   doing `Playing Snake...`
   call riscbbsdoor `<Converse$Dir>.BBS.Doors.!SnakeDoor.!Run %{line}`
   doing
   goto doors_menu
label run_breakout
   doing `Playing Breakout...`
   call riscbbsdoor `<Converse$Dir>.BBS.Doors.!Breakout.!Run %{line}`
   doing
   goto doors_menu
label run_boxed
   doing `Playing Boxed In...`
   call riscbbsdoor `<Converse$Dir>.BBS.Doors.!BoxedDoor.!Run %{line}`
   doing
   goto doors_menu
label run_trivia
   doing `Playing Trivia...`
   call riscbbsdoor `<Converse$Dir>.BBS.Doors.!TrivDoor.!Run %{line}`
   doing
   goto doors_menu
label run_purity
   doing `Running the Purity Test...`
   call riscbbsdoor `<Converse$Dir>.BBS.Doors.!Purity.!Run %{line}`
   doing
   goto doors_menu
label run_wall
   doing `Visiting The Wall...`
   call riscbbsdoor `<Converse$Dir>.BBS.Doors.!Wall.!Run %{line}`
   doing
   goto doors_menu

label doors_quit
   return
}
