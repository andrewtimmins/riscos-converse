{
   /* New user: show the styled intro, then run the registration questionnaire */
   cls
   doing `New User Registration`
   type `<Converse$Dir>.BBS.Screens.NewUser`
   anykey
   cls
   newuser
   /* Back to the logon prompt so they can sign in with the new account */
   pause 2000
   script `<Converse$Dir>.BBS.Prelogon`
}
