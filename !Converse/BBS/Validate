{
   /* Sysop: validate pending new users. New accounts are created with
      registered != 1 (awaiting approval); approving sets registered = 1 via
      usersetby, granting full access on their next login. Gated to sysop by
      the main-menu entry. */

   set esc = chr(27)
   set nl  = chr(13) + chr(10)
   set rule = repeat(chr(205), 52)

label val_list
   cls
   set line = nl + `  ` + esc + `[1;33mVALIDATE NEW USERS` + esc + `[0m` + nl
   print %{line}
   set line = `  ` + esc + `[0;36m` + rule + esc + `[0m` + nl + nl
   print %{line}

   set total = usercount()
   set i = 0
   set pend = 0
   while i < total
      set reg = userbyindex(i, `registered`)
      if reg != 1 then
         set uname = userbyindex(i, `username`)
         set ureal = userbyindex(i, `realname`)
         set line = `  ` + esc + `[1;37m` + pad(str(i), 3) + esc + `[0m  ` + esc + `[1;33m` + pad(uname, 20) + esc + `[0;37m` + ureal + esc + `[0m` + nl
         print %{line}
         set pend = pend + 1
      endif
      set i = i + 1
   endwhile
   if pend == 0 then
      set line = `  ` + esc + `[1;32mNo users are awaiting validation.` + esc + `[0m` + nl
      print %{line}
   endif

   set line = nl + `  ` + esc + `[0;36m` + rule + esc + `[0m` + nl
   print %{line}
   set line = `  Enter a number to approve, [Q] back: `
   print %{line}
   prompt vc line

   if upper(vc) == `Q` then
      goto val_done
   endif
   set idx = int(vc)
   if idx < 0 then
      goto val_list
   endif
   if idx >= total then
      goto val_list
   endif
   set treg = userbyindex(idx, `registered`)
   if treg == 1 then
      goto val_list
   endif
   set tuser = userbyindex(idx, `username`)
   set r = usersetby(tuser, `registered`, 1)
   set line = nl + `  ` + esc + `[1;32mApproved ` + tuser + ` - full access on next login.` + esc + `[0m` + nl
   print %{line}
   anykey
   goto val_list

label val_done
}
