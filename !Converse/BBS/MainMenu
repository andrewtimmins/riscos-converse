{
   /* Main Menu - declarative menu primitive. `menu` draws Screens.MainMenu and
      runs MainOverlay (status strip + rotating thought + prompt) on each
      (re)display. Submenu / content keys dispatch straight to their script
      (which returns here and redisplays); the inline actions and log-off use
      action labels. '?' lists the on-item help. The dev-demo keys (x/z/y/k) are
      hidden (not on the art) and gated to sysop level. */

label main_menu
   menu `<Converse$Dir>.BBS.Screens.MainMenu` overlay `<Converse$Dir>.BBS.MainOverlay`
      on `m` help `Message bases`        script `<Converse$Dir>.BBS.Messagebase`
      on `f` help `File libraries`       script `<Converse$Dir>.BBS.Filebase`
      on `d` help `Doors & games`        script `<Converse$Dir>.BBS.DoorsMenu`
      on `w` help `The Wall (one-liners)` script `<Converse$Dir>.BBS.Oneliners`
      on `b` help `Bulletins & news`     script `<Converse$Dir>.BBS.Bulletins`
      on `l` help `Last callers`         script `<Converse$Dir>.BBS.LastCallers`
      on `u` help `Your settings`        script `<Converse$Dir>.BBS.Settings`
      on `g` help `Leave feedback`       script `<Converse$Dir>.BBS.Feedback`
      on `h` help `Hall of fame / stats` script `<Converse$Dir>.BBS.Stats`
      on `v` help `Voting booth`         script `<Converse$Dir>.BBS.Voting`
      on `t` help `Tell a user`          script `<Converse$Dir>.BBS.Tell`
      on `a` help `QWK offline mail`     script `<Converse$Dir>.BBS.QWK`
      on `s` help `Scan for new content` goto go_scan
      on `i` help `Your inbox`           goto go_inbox
      on `o` help `Who's online`         goto go_online
      on `c` help `Chat to the sysop`    goto go_chat
      on `x` level 500                   script `<Converse$Dir>.BBS.ScriptTest`
      on `z` level 500                   script `<Converse$Dir>.BBS.Quiz`
      on `y` level 500                   script `<Converse$Dir>.BBS.MenuDemo`
      on `k` level 500                   script `<Converse$Dir>.BBS.QueueDemo`
      on `q` help `Log off`              goto go_quit
   endmenu

label go_scan
   cls
   doing `Scanning for new content...`
   loginscan
   doing
   anykey
   goto main_menu
label go_inbox
   cls
   doing `Reading inbox...`
   more 0
   messagebase inbox
   more 1
   doing
   anykey
   goto main_menu
label go_online
   cls
   doing `Who's online...`
   online
   doing
   anykey
   goto main_menu
label go_chat
   cls
   doing `Paging the sysop...`
   sysopchat
   doing
   anykey
   goto main_menu

label go_quit
   type `<Converse$Dir>.BBS.Screens.Goodbye`
   pause 1500
   logoff
}
