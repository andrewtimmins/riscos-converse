{
   /* Main Menu - declarative menu primitive. `menu` draws Screens.MainMenu and
      runs MainOverlay (status strip + rotating thought + prompt) on each
      (re)display. Submenu / content keys dispatch straight to their script
      (which returns here and redisplays); the inline actions and log-off use
      action labels. '?' lists the on-item help. The dev-demo keys (x/z/y/k) are
      hidden (not on the art) and gated to sysop level. */

label main_menu
   menu `<Converse$Dir>.BBS.Screens.MainMenu` overlay `<Converse$Dir>.BBS.MainOverlay`
      on `m` at 6 13  text `Message bases`  help `Message bases`        script `<Converse$Dir>.BBS.Messagebase`
      on `f` at 32 13 text `File libraries` help `File libraries`       script `<Converse$Dir>.BBS.Filebase`
      on `d` at 32 14 text `Doors & games`  help `Doors & games`        script `<Converse$Dir>.BBS.DoorsMenu`
      on `w` at 57 13 text `The Wall`       help `The Wall (one-liners)` script `<Converse$Dir>.BBS.Oneliners`
      on `b` at 57 14 text `Bulletins`      help `Bulletins & news`     script `<Converse$Dir>.BBS.Bulletins`
      on `l` at 57 15 text `Last callers`   help `Last callers`         script `<Converse$Dir>.BBS.LastCallers`
      on `n` at 57 17 text `Node chat`      help `Node chat (live teleconference with other callers)` goto go_chatroom
      on `u` at 6 19  text `Settings`       help `Your settings`        script `<Converse$Dir>.BBS.Settings`
      on `g` at 6 20  text `Feedback`       help `Leave feedback`       script `<Converse$Dir>.BBS.Feedback`
      on `h` at 32 20 text `Hall of fame`   help `Hall of fame / stats` script `<Converse$Dir>.BBS.Stats`
      on `v` at 57 16 text `Voting booth`   help `Voting booth`         script `<Converse$Dir>.BBS.Voting`
      on `t` at 6 21  text `Tell a user`    help `Tell a user`          script `<Converse$Dir>.BBS.Tell`
      on `a` at 6 16  text `QWK mail`       help `QWK offline mail`     script `<Converse$Dir>.BBS.QWK`
      on `s` at 6 14  text `Scan new posts` help `Scan for new content` goto go_scan
      on `i` at 6 15  text `Your inbox`     help `Your inbox`           goto go_inbox
      on `o` at 32 15 text `Who's online`   help `Who's online`         goto go_online
      on `c` at 32 19 text `Chat to sysop`  help `Chat to the sysop`    goto go_chat
      on `x` level 500                   script `<Converse$Dir>.BBS.ScriptTest`
      on `z` level 500                   script `<Converse$Dir>.BBS.Quiz`
      on `y` level 500                   script `<Converse$Dir>.BBS.MenuDemo`
      on `k` level 500                   script `<Converse$Dir>.BBS.QueueDemo`
      on `j` level 500 help `Validate new users (sysop)` script `<Converse$Dir>.BBS.Validate`
      on `p` at 32 21 text `Who's Who`     help `User profiles / who's who`  script `<Converse$Dir>.BBS.Profiles`
      on `q` at 57 20 text `Log off`       help `Log off`              goto go_quit
   endmenu

label go_scan
   cls
   doing `Scanning for new content...`
   loginscan
   doing
   anykey
   goto main_menu
label go_inbox
   cls
   doing `Reading inbox...`
   more 0
   messagebase inbox
   more 1
   doing
   anykey
   goto main_menu
label go_online
   cls
   doing `Who's online...`
   online
   doing
   anykey
   goto main_menu
label go_chat
   cls
   doing `Paging the sysop...`
   sysopchat
   doing
   anykey
   goto main_menu

label go_chatroom
   teleconf
   goto main_menu

label go_quit
   type `<Converse$Dir>.BBS.Screens.Goodbye`
   pause 1500
   logoff
}
