{
   /* File Libraries - declarative menu primitive. `menu` draws the screen and
      runs FileOverlay (status strip + library/area + prompt) on each
      (re)display; each `on` routes a key with a `help` string for '?'. Action
      blocks run then `goto fb_menu` to redisplay; `q` leaves via fb_quit. */

label fb_menu
   menu `<Converse$Dir>.BBS.Screens.FileMenu` overlay `<Converse$Dir>.BBS.FileOverlay`
      on `l`  help `List files in the current area`   goto fb_list
      on `a`  help `Change file library or area`      goto fb_areas
      on `s`  help `Scan for new files`               goto fb_scan
      on `v`  help `View a file's details`            goto fb_view
      on `d`  help `Download a file`                   goto fb_down
      on `u`  help `Upload a file`                     goto fb_up
      on `q`  help `Back to the main menu`             goto fb_quit
   endmenu

label fb_list
   cls
   doing `Browsing files...`
   filebase browse
   doing
   anykey
   goto fb_menu
label fb_areas
   cls
   filebase list
   filebase areas
   goto fb_menu
label fb_scan
   cls
   loginscan
   anykey
   goto fb_menu
label fb_view
   print `\r\nFile ID to view: `
   readline file_id
   if file_id == `` goto fb_menu
   filebase info %{file_id}
   print `\r\n`
   anykey
   goto fb_menu
label fb_down
   print `\r\nFile ID to download: `
   readline file_id
   if file_id == `` goto fb_menu
   doing `Sending file...`
   sendfile %{file_id} zmodem
   doing
   anykey
   goto fb_menu
label fb_up
   cls
   doing `Receiving file...`
   receivefile
   doing
   anykey
   goto fb_menu
label fb_quit
   return
}
