{
   /* File Libraries - ANSI. Draws Screens.FileMenu then dispatches. */

label fb_menu
   type `<Converse$Dir>.BBS.Screens.FileMenu`
   pos 16 21
   prompt choice char echo

   if choice == `l` goto fb_list
   if choice == `L` goto fb_list
   if choice == `a` goto fb_areas
   if choice == `A` goto fb_areas
   if choice == `s` goto fb_scan
   if choice == `S` goto fb_scan
   if choice == `v` goto fb_view
   if choice == `V` goto fb_view
   if choice == `d` goto fb_down
   if choice == `D` goto fb_down
   if choice == `u` goto fb_up
   if choice == `U` goto fb_up
   if choice == `q` goto fb_quit
   if choice == `Q` goto fb_quit
   goto fb_menu

label fb_list
   cls
   doing `Browsing files...`
   filebase browse
   doing
   anykey
   goto fb_menu
label fb_areas
   cls
   filebase list
   filebase areas
   goto fb_menu
label fb_scan
   cls
   loginscan
   anykey
   goto fb_menu
label fb_view
   print `\r\nFile ID to view: `
   readline file_id
   if file_id == `` goto fb_menu
   filebase info %{file_id}
   print `\r\n`
   anykey
   goto fb_menu
label fb_down
   print `\r\nFile ID to download: `
   readline file_id
   if file_id == `` goto fb_menu
   doing `Sending file...`
   sendfile %{file_id} zmodem
   doing
   anykey
   goto fb_menu
label fb_up
   cls
   doing `Receiving file...`
   receivefile
   doing
   anykey
   goto fb_menu
label fb_quit
   return
}
