{
   /* QWK Offline Mail - boxed. Download a packet to read/reply offline, then
      upload the .REP reply packet. Reached from the main menu 'A' key.
      Packages the caller's current message base, so select one first (M). */

label qwk_menu
   type `<Converse$Dir>.BBS.Screens.QWK`
   pos 27 24
   prompt c char echo
   if c == `d` goto qwk_dl
   if c == `D` goto qwk_dl
   if c == `n` goto qwk_new
   if c == `N` goto qwk_new
   if c == `u` goto qwk_ul
   if c == `U` goto qwk_ul
   if c == `q` goto qwk_done
   if c == `Q` goto qwk_done
   goto qwk_menu

label qwk_dl
   pos 7 20
   fg 14
   print `Building + sending your QWK packet...`
   std
   qwkdownload zmodem
   pos 7 20
   fg 10
   print `Download finished.                                       `
   std
   prompt k char
   goto qwk_menu

label qwk_new
   pos 7 20
   fg 14
   print `Building + sending new mail...`
   std
   qwkdownload zmodem new
   pos 7 20
   fg 10
   print `Download finished.                                       `
   std
   prompt k char
   goto qwk_menu

label qwk_ul
   pos 7 20
   fg 14
   print `Start your ZMODEM upload of the .REP reply packet now...`
   std
   qwkupload zmodem
   pos 7 20
   fg 10
   print `Upload processed.                                        `
   std
   prompt k char
   goto qwk_menu

label qwk_done
   return
}
