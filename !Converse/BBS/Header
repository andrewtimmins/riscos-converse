{
   /* Live status overlay for framed menus. No cls - the caller has already
      drawn the framed screen (Screens.MainMenu). Prints the status line inside
      the frame at row 10. Palette: 15 white, 11 bright yellow, 6 cyan,
      10 green. */

   set dot = chr(250)
   pos 6 10
   fg 15
   print `%{ =userget("realname") }`
   fg 6
   print `  %{dot}  level `
   fg 11
   print `%{ =userget("level") }`
   fg 6
   print `  %{dot}  call #`
   fg 11
   print `%{usercalls}`
   fg 6
   print `  %{dot}  `
   fg 11
   print `%{timeleft}`
   fg 6
   print ` min left  %{dot}  `
   fg 10
   print `%{onlineusers}`
   fg 6
   print ` online`
   std
   return
}
