   /* ---- function definitions (skipped in normal flow) ---- */
   function square(n)
      return n * n
   endfunction

   function greet(who)
      local msg = `Hello, ` + who + `!`
      return msg
   endfunction

   function fact(n)
      if n <= 1 then
         return 1
      endif
      return n * fact(n - 1)
   endfunction

   function max3(x, y, z)
      local m = x
      if y > m then
         set m = y
      endif
      if z > m then
         set m = z
      endif
      return m
   endfunction
