   /* Scripting engine feature demo (Tier-1 upgrades):
      1. expression evaluator   2. string library
      3. data API + user-defined functions.
      Reached from the main menu with the 'X' hot-key. */

   cls
   fg 14
   print `=== Converse Scripting Engine Test ===`
   print ``
   std

   /* ---- 1. EXPRESSIONS: precedence, parens, unary NOT ---- */
   fg 11
   print `1. Expressions`
   std
   set a = 3
   set b = 4
   set c = a*a + b*b
   print `   a*a + b*b (3,4) = %{c}   (expect 25)`
   set d = (a + b) * 2
   print `   (a+b)*2          = %{d}   (expect 14)`
   set flag = a < b and not (a == b)
   print `   a<b and not(a==b)= %{flag}   (expect 1)`
   print ``

   /* ---- 2. STRING LIBRARY (inline expression macros %{ =... }) ---- */
   fg 11
   print `2. String functions`
   std
   print `   upper            = %{ =upper("converse") }   (expect CONVERSE)`
   print `   left 4           = %{ =left("RISC OS", 4) }   (expect RISC)`
   print `   substr 2,4       = %{ =substr("scripting", 2, 4) }   (expect ript)`
   print `   replace - with : = %{ =replace("a-b-c", "-", ":") }   (expect a:b:c)`
   print `   find 'pt'        = %{ =find("scripting", "pt") }   (expect 4, 0-based)`
