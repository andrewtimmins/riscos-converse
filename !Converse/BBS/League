{
   /* InterBBS League - display the shared score table (Support module SWI
      ConverseBBS_League via leaguecount()/leagueentry()). The store is kept
      sorted by door key then score desc, so we walk it, start a new section
      when the key changes, and rank rows top-first (top 5 per door).

      Engine gotchas: `print` does NOT evaluate `+`/functions or translate
      `\033`; build each line with `set` (chr(27)=ESC, chr(13)+chr(10)=CRLF,
      CP437 glyphs via chr) then print %{var}. */

   set esc = chr(27)
   set nl  = chr(13) + chr(10)
   set rule = repeat(chr(205), 60)          /* CP437 205 = double horizontal */
   set us  = chr(17)                        /* CP437 17 = left-pointing triangle */
   set dot = chr(175)                        /* CP437 175 = right guillemet */

   /* --- DEMO SEED (remove once real doors report via leaguescore) --- */
   if leaguecount() == 0 then
      set x = leaguescore(`snake`, `Richard Paddle`, 70)
      set x = leaguescore(`snake`, `Andy`, 120)
      set x = leaguescore(`snake`, `Zaphod`, 95)
      set x = leaguescore(`trivia`, `Andy`, 45)
      set x = leaguescore(`trivia`, `Guest`, 20)
      set x = leaguescore(`boxed`, `Andy`, 30)
   endif

   cls
   set line = nl + `  ` + esc + `[1;33m` + rule + esc + `[0m` + nl
   print %{line}
   set line = `  ` + esc + `[1;33m` + `           I N T E R B B S   L E A G U E` + esc + `[0m` + nl
   print %{line}
   set line = `  ` + esc + `[0;36m` + rule + esc + `[0m` + nl
   print %{line}

   set n = leaguecount()
   if n == 0 then
      set line = nl + `  ` + esc + `[1;37mNo scores yet - go play a door!` + esc + `[0m` + nl
      print %{line}
   endif

   set prev = `~none~`
   set rank = 0
   set i = 0
   while i < n
      set dkey = leagueentry(i, `key`)
      set pl   = leagueentry(i, `player`)
      set bd   = leagueentry(i, `board`)
      set sc   = leagueentry(i, `score`)
      if dkey != prev then
         set prev = dkey
         set rank = 0
         set line = nl + `  ` + esc + `[1;36m` + dot + ` ` + upper(dkey) + esc + `[0m` + nl
         print %{line}
      endif
      set rank = rank + 1
      if rank <= 5 then
         set tag = ``
         if bd == `` then
            set tag = esc + `[1;32m  ` + us + ` us` + esc + `[0m`
         else
            set tag = esc + `[0;36m  [` + bd + `]` + esc + `[0m`
         endif
         set line = `    ` + esc + `[1;33m` + pad(str(rank), 3) + esc + `[0m` + esc + `[1;37m` + pad(pl, 22) + esc + `[0m` + esc + `[1;32m` + pad(sc, 6) + esc + `[0m` + tag + nl
         print %{line}
      endif
      set i = i + 1
   endwhile

   set line = nl + `  ` + esc + `[0;36m` + rule + esc + `[0m` + nl
   print %{line}
   anykey
}
